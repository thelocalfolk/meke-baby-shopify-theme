{% comment %}
  Section: Collection Card Stack
  Theme: Horizon (Meke Baby)

  Stacked card layout — image on top, heading + description + button stacked
  underneath. Counterpart to collection-card-grid (which overlays text on the
  image). Each card is a separate block, fully configurable in the theme editor.

  Includes:
  - Optional centred section heading above the grid
  - Schema-driven horizontal (edge) padding so the section pulls in from the
    page edges, matching the rest of the Meke Baby home page
  - Independent desktop and mobile padding controls
{% endcomment %}

<div
  id="section-{{ section.id }}"
  class="collection-card-stack"
  style="
    background-color: {{ section.settings.background_colour }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_horizontal }}px;
    padding-right: {{ section.settings.padding_horizontal }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <div class="collection-card-stack__header collection-card-stack__header--{{ section.settings.heading_alignment }}">
      <p
        class="collection-card-stack__section-heading {{ section.settings.type_preset }}"
        style="{% render 'typography-style', settings: section.settings %} color: {{ section.settings.section_heading_colour }};"
      >
        {{ section.settings.heading | escape }}
      </p>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="collection-card-stack__grid">
      {%- for block in section.blocks -%}
        {%- assign card_image_alt = block.settings.heading | escape -%}

        <div class="collection-card-stack__card" {{ block.shopify_attributes }}>

          <div class="collection-card-stack__image-wrap">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  alt: card_image_alt,
                  widths: '400, 600, 800, 1000, 1200, 1400',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  class: 'collection-card-stack__image'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-card-stack__image collection-card-stack__image--placeholder' }}
            {%- endif -%}
          </div>

          <div class="collection-card-stack__content">

            {%- if block.settings.heading != blank -%}
              <p
                class="collection-card-stack__heading {{ block.settings.type_preset }}"
                style="{% render 'typography-style', settings: block.settings %} color: {{ section.settings.heading_colour }};"
              >
                {{ block.settings.heading | escape }}
              </p>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="collection-card-stack__description" style="color: {{ section.settings.heading_colour }};">
                {{ block.settings.description | escape }}
              </p>
            {%- endif -%}

            {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
              <div class="collection-card-stack__button-wrap">
                <a
                  href="{{ block.settings.button_url }}"
                  class="collection-card-stack__button"
                  style="
                    background-color: {{ section.settings.button_background }};
                    color: {{ section.settings.button_text_colour }};
                    border-radius: {{ section.settings.button_border_radius }}px;
                  "
                >
                  {{ block.settings.button_label | escape }}
                </a>
              </div>
            {%- endif -%}

          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% comment %} Liquid-dependent styles — grid, spacing, aspect ratio {% endcomment %}
<style>
  #section-{{ section.id }} .collection-card-stack__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
  }

  #section-{{ section.id }} .collection-card-stack__image-wrap {
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  #section-{{ section.id }} .collection-card-stack__content {
    padding-top: {{ section.settings.content_gap }}px;
  }

  #section-{{ section.id }} .collection-card-stack__button-wrap {
    margin-top: {{ section.settings.button_top_gap }}px;
  }

  #section-{{ section.id }} .collection-card-stack__button {
    padding: {{ section.settings.button_padding_v }}px {{ section.settings.button_padding_h }}px;
  }

  #section-{{ section.id }} .collection-card-stack__header {
    margin-bottom: {{ section.settings.heading_bottom_gap }}px;
  }

  @media screen and (max-width: 749px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: {{ section.settings.mobile_padding_horizontal }}px;
      padding-right: {{ section.settings.mobile_padding_horizontal }}px;
    }

    #section-{{ section.id }} .collection-card-stack__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_card_gap }}px;
    }

    #section-{{ section.id }} .collection-card-stack__header {
      margin-bottom: {{ section.settings.mobile_heading_bottom_gap }}px;
    }
  }
</style>

{% comment %} Static layout styles {% endcomment %}
{% stylesheet %}
  .collection-card-stack__header {
    width: 100%;
  }

  .collection-card-stack__header--left {
    text-align: left;
  }

  .collection-card-stack__header--center {
    text-align: center;
  }

  .collection-card-stack__header--right {
    text-align: right;
  }

  .collection-card-stack__section-heading {
    margin: 0;
  }

  .collection-card-stack__card {
    display: flex;
    flex-direction: column;
  }

  .collection-card-stack__image-wrap {
    width: 100%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .collection-card-stack__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection-card-stack__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-card-stack__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .collection-card-stack__heading {
    margin: 0;
  }

  .collection-card-stack__description {
    margin: 0;
    opacity: 0.75;
  }

  .collection-card-stack__button {
    display: inline-block;
    text-decoration: none;
    font-size: inherit;
    line-height: 1;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .collection-card-stack__button:hover {
    opacity: 0.85;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Card Stack",
  "tag": "section",
  "class": "collection-card-stack-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to hide the heading."
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Heading style",
      "info": "Inherits from your theme typography settings",
      "options": [
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "section_heading_colour",
      "label": "Heading colour",
      "default": "#8c7b72"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
