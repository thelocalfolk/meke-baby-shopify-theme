{%- liquid
  assign bg_image = section.settings.image
  assign mobile_image = section.settings.image_mobile
  assign fallback_url = section.settings.image_url
  assign btn_class = 'button'
  if section.settings.button_style == 'secondary'
    assign btn_class = 'button-secondary'
  endif
-%}

<div
  id="MekeBabyHero-{{ section.id }}"
  class="meke-hero color-{{ section.settings.color_scheme }}"
  style="
    min-height: {{ section.settings.min_height }}svh;
    --hero-align: {{ section.settings.content_position }};
    --hero-star-size: {{ section.settings.star_size }}px;
    --hero-heading-size: {{ section.settings.heading_size }}px;
    --hero-subheading-size: {{ section.settings.subheading_size }}px;
    --hero-content-max-width: {{ section.settings.content_max_width }}px;
    --hero-heading-max-width: {{ section.settings.heading_max_width }}px;
    --hero-subheading-max-width: {{ section.settings.subheading_max_width }}px;
    --hero-padding-top: {{ section.settings.padding_top }}px;
    --hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hero-padding-horizontal: {{ section.settings.padding_horizontal }}px;
    --hero-bg-position: {{ section.settings.bg_position }};
    --hero-bg-position-mobile: {{ section.settings.bg_position_mobile }};
    {% if bg_image != blank %}
      --hero-bg-desktop: url('{{ bg_image | image_url: width: 2400 }}');
    {% elsif fallback_url != blank %}
      --hero-bg-desktop: url('{{ fallback_url }}');
    {% endif %}
    {% if mobile_image != blank %}
      --hero-bg-mobile: url('{{ mobile_image | image_url: width: 1200 }}');
    {% elsif bg_image != blank %}
      --hero-bg-mobile: url('{{ bg_image | image_url: width: 1200 }}');
    {% elsif fallback_url != blank %}
      --hero-bg-mobile: url('{{ fallback_url }}');
    {% endif %}
  "
>
  <div class="meke-hero__inner page-width">
    <div class="meke-hero__content">
      {%- if section.settings.star_rating != blank -%}
        <p class="meke-hero__stars">{{ section.settings.star_rating }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="meke-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="meke-hero__subheading">{{ section.settings.subheading | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="{{ btn_class }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .meke-hero {
    background-size: cover;
    background-position: var(--hero-bg-position, center);
    background-image: var(--hero-bg-desktop);
    display: flex;
    align-items: var(--hero-align, flex-end);
    position: relative;
  }

  .meke-hero__inner {
    width: 100%;
    padding-block: var(--hero-padding-top, 40px) var(--hero-padding-bottom, 40px);
    padding-inline: max(var(--hero-padding-horizontal, 2rem), 5vw);
  }

  .meke-hero__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: var(--hero-content-max-width, 560px);
    color: rgb(var(--color-foreground));
  }

  .meke-hero__stars {
    font-size: var(--hero-star-size, 14px);
    letter-spacing: 0.03em;
    margin: 0;
  }

  .meke-hero__heading {
    font-family: var(--font-public-sans--family);
    font-size: var(--hero-heading-size, 48px);
    font-weight: 400;
    line-height: 1.05;
    margin: 0;
    max-width: var(--hero-heading-max-width, 100%);
    color: rgb(var(--color-foreground-heading));
  }

  .meke-hero__subheading {
    font-size: var(--hero-subheading-size, 16px);
    line-height: 1.55;
    max-width: var(--hero-subheading-max-width, 400px);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .meke-hero {
      background-image: var(--hero-bg-mobile);
      background-position: var(--hero-bg-position-mobile, center);
    }

    .meke-hero__inner {
      padding-block: var(--hero-padding-top, 32px) var(--hero-padding-bottom, 32px);
      padding-inline: 1.25rem;
    }

    .meke-hero__content {
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mekè Baby Hero",
  "tag": "section",
  "class": "meke-hero-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Replaces the URL below when set"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Recommended portrait crop e.g. 750 x 1000px. Falls back to main image if not set."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "default": "https://cdn.shopify.com/s/files/1/0785/7458/4107/files/Image_179da885-c70a-4fc6-8ba3-1d4f72954f1f.jpg?v=1777347930",
      "info": "Used when no image is selected above"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image focal point",
      "options": [
        { "value": "top left", "label": "Top left" },
        { "value": "top center", "label": "Top center" },
        { "value": "top right", "label": "Top right" },
        { "value": "center left", "label": "Center left" },
        { "value": "center", "label": "Center" },
        { "value": "center right", "label": "Center right" },
        { "value": "bottom left", "label": "Bottom left" },
        { "value": "bottom center", "label": "Bottom center" },
        { "value": "bottom right", "label": "Bottom right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "bg_position_mobile",
      "label": "Image focal point (mobile)",
      "options": [
        { "value": "top left", "label": "Top left" },
        { "value": "top center", "label": "Top center" },
        { "value": "top right", "label": "Top right" },
        { "value": "center left", "label": "Center left" },
        { "value": "center", "label": "Center" },
        { "value": "center right", "label": "Center right" },
        { "value": "bottom left", "label": "Bottom left" },
        { "value": "bottom center", "label": "Bottom center" },
        { "value": "bottom right", "label": "Bottom right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "star_rating",
      "label": "Star rating text",
      "default": "★★★★★   4.9 Stars"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star rating text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A better way to feed."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading text size",
      "min": 24,
      "max": 96,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 100,
      "max": 900,
      "step": 10,
      "default": 560,
      "unit": "px"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mekè Baby gives you a considered feeding system designed to remove uncertainty and support safe, consistent feeding — every time."
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading text size",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_max_width",
      "label": "Subheading max width",
      "min": 100,
      "max": 900,
      "step": 10,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Shop by Solution"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-end"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content block max width",
      "min": 200,
      "max": 1200,
      "step": 20,
      "default": 560,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 30,
      "max": 100,
      "step": 5,
      "default": 55,
      "unit": "vh",
      "info": "As a percentage of the viewport height"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding horizontal",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 32,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Mekè Baby Hero"
    }
  ]
}
{% endschema %}