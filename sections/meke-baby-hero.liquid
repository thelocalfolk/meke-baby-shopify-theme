{%- liquid
  assign bg_image = section.settings.image
  assign fallback_url = section.settings.image_url
  assign btn_class = 'button'
  if section.settings.button_style == 'secondary'
    assign btn_class = 'button-secondary'
  endif
-%}

<div
  id="MekeBabyHero-{{ section.id }}"
  class="meke-hero color-{{ section.settings.color_scheme }}"
  style="
    min-height: {{ section.settings.min_height }}svh;
    --hero-align: {{ section.settings.content_position }};
    --hero-star-size: {{ section.settings.star_size }}px;
    --hero-heading-size: {{ section.settings.heading_size }}px;
    --hero-subheading-size: {{ section.settings.subheading_size }}px;
    {% if bg_image != blank %}
      background-image: url('{{ bg_image | image_url: width: 2400 }}');
    {% elsif fallback_url != blank %}
      background-image: url('{{ fallback_url }}');
    {% endif %}
  "
>
  <div class="meke-hero__inner page-width">
    <div class="meke-hero__content">
      {%- if section.settings.star_rating != blank -%}
        <p class="meke-hero__stars">{{ section.settings.star_rating }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="meke-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="meke-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="{{ btn_class }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .meke-hero {
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: var(--hero-align, flex-end);
    position: relative;
  }

  .meke-hero__inner {
    width: 100%;
    padding-block: 40px;
    padding-inline: max(2rem, 5vw);
  }

  .meke-hero__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 560px;
    color: rgb(var(--color-foreground));
  }

  .meke-hero__stars {
    font-size: var(--hero-star-size, 14px);
    letter-spacing: 0.03em;
    margin: 0;
  }

  .meke-hero__heading {
    font-family: var(--font-public-sans--family);
    font-size: var(--hero-heading-size, 48px);
    font-weight: 400;
    line-height: 1.05;
    margin: 0;
    color: rgb(var(--color-foreground-heading));
  }

  .meke-hero__subheading {
    font-size: var(--hero-subheading-size, 16px);
    line-height: 1.55;
    max-width: 400px;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .meke-hero__inner {
      padding-block: 32px;
      padding-inline: 1.25rem;
    }

    .meke-hero__content {
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mekè Baby Hero",
  "tag": "section",
  "class": "meke-hero-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Replaces the URL below when set"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "default": "https://cdn.shopify.com/s/files/1/0785/7458/4107/files/Image_179da885-c70a-4fc6-8ba3-1d4f72954f1f.jpg?v=1777347930",
      "info": "Used when no image is selected above"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "star_rating",
      "label": "Star rating text",
      "default": "★★★★★   4.9 Stars"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star rating text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A better way to feed."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading text size",
      "min": 24,
      "max": 96,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mekè Baby gives you a considered feeding system designed to remove uncertainty and support safe, consistent feeding — every time."
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading text size",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Shop by Solution"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-end"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 30,
      "max": 100,
      "step": 5,
      "default": 55,
      "unit": "vh",
      "info": "As a percentage of the viewport height"
    }
  ],
  "presets": [
    {
      "name": "Mekè Baby Hero"
    }
  ]
}
{% endschema %}