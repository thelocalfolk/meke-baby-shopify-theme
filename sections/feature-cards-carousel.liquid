{% comment %}
  Section: Feature Cards Carousel
  Horizontally scrollable carousel of tall image cards with frosted glass pill label
  (top-left), large overlay heading and body text (bottom). Fixed card width ensures
  cards always carousel rather than shrink — right-edge card is half-visible to signal scroll.
  Typography follows the same preset + custom pattern as video-feedback-carousel.
  Built for the Mekè Baby Horizon theme.
{% endcomment %}

{%- liquid
  assign ss = section.settings
  assign blocks = section.blocks

  # Build section heading style string
  assign heading_style = ''
  if ss.heading_color != blank and ss.heading_color != ''
    assign heading_style = heading_style | append: '--color: ' | append: ss.heading_color | append: ';'
  endif
  if ss.heading_type_preset == 'custom'
    assign h_font_weight = ss.heading_font | replace: 'family', 'weight'
    assign heading_style = heading_style | append: '--font-family: ' | append: ss.heading_font | append: ';'
    assign heading_style = heading_style | append: '--font-weight: ' | append: h_font_weight | append: ';'
    assign heading_style = heading_style | append: '--font-size: ' | append: ss.heading_font_size | append: ';'
    assign heading_style = heading_style | append: '--text-transform: ' | append: ss.heading_case | append: ';'
    assign heading_style = heading_style | append: '--line-height: var(--line-height--heading-' | append: ss.heading_line_height | append: ');'
    assign heading_style = heading_style | append: '--letter-spacing: var(--letter-spacing--heading-' | append: ss.heading_letter_spacing | append: ');'
  endif

  if ss.heading_type_preset == 'custom'
    assign heading_class = 'feature-cards__heading custom-typography custom-font-size'
  else
    assign heading_class = 'feature-cards__heading ' | append: ss.heading_type_preset
  endif
-%}

<div class="section-background color-{{ ss.color_scheme }}"></div>

<div
  class="
    section
    section--{{ ss.section_width }}
    color-{{ ss.color_scheme }}
    section-feature-cards
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: ss %}
    --fcc-card-height: {{ ss.card_height }}px;
    --fcc-card-radius: {{ ss.card_border_radius }}px;
    --fcc-card-width: {{ ss.card_width }}px;
    --fcc-gap: {{ ss.card_gap }}px;
    --fcc-label-size: {{ ss.label_size }}px;
  "
>
  {%- if ss.heading != blank -%}
    <h2 class="{{ heading_class }}" style="{{ heading_style }}">{{ ss.heading | escape }}</h2>
  {%- endif -%}

  {%- if blocks.size > 0 -%}
    <div class="feature-cards__track" role="list">
      {%- for block in blocks -%}
        {%- if block.type == 'card' -%}
          {%- liquid
            assign bs = block.settings

            # Card heading style
            assign card_heading_style = ''
            if bs.card_heading_color != blank and bs.card_heading_color != ''
              assign card_heading_style = card_heading_style | append: '--color: ' | append: bs.card_heading_color | append: ';'
            endif
            if bs.card_heading_preset == 'custom'
              assign ch_font_weight = bs.card_heading_font | replace: 'family', 'weight'
              assign card_heading_style = card_heading_style | append: '--font-family: ' | append: bs.card_heading_font | append: ';'
              assign card_heading_style = card_heading_style | append: '--font-weight: ' | append: ch_font_weight | append: ';'
              assign card_heading_style = card_heading_style | append: '--font-size: ' | append: bs.card_heading_font_size | append: ';'
              assign card_heading_style = card_heading_style | append: '--text-transform: ' | append: bs.card_heading_case | append: ';'
              assign card_heading_style = card_heading_style | append: '--line-height: var(--line-height--heading-' | append: bs.card_heading_line_height | append: ');'
              assign card_heading_style = card_heading_style | append: '--letter-spacing: var(--letter-spacing--heading-' | append: bs.card_heading_letter_spacing | append: ');'
            endif
            if bs.card_heading_preset == 'custom'
              assign card_heading_class = 'feature-cards__card-heading custom-typography custom-font-size'
            else
              assign card_heading_class = 'feature-cards__card-heading ' | append: bs.card_heading_preset
            endif

            # Card body style
            assign card_body_style = ''
            if bs.card_body_color != blank and bs.card_body_color != ''
              assign card_body_style = card_body_style | append: '--color: ' | append: bs.card_body_color | append: ';'
            endif
            if bs.card_body_preset == 'custom'
              assign cb_font_weight = bs.card_body_font | replace: 'family', 'weight'
              assign card_body_style = card_body_style | append: '--font-family: ' | append: bs.card_body_font | append: ';'
              assign card_body_style = card_body_style | append: '--font-weight: ' | append: cb_font_weight | append: ';'
              assign card_body_style = card_body_style | append: '--font-size: ' | append: bs.card_body_font_size | append: ';'
              assign card_body_style = card_body_style | append: '--text-transform: ' | append: bs.card_body_case | append: ';'
              assign card_body_style = card_body_style | append: '--line-height: var(--line-height--body-' | append: bs.card_body_line_height | append: ');'
              assign card_body_style = card_body_style | append: '--letter-spacing: var(--letter-spacing--body-' | append: bs.card_body_letter_spacing | append: ');'
            endif
            if bs.card_body_preset == 'custom'
              assign card_body_class = 'feature-cards__card-body custom-typography custom-font-size'
            else
              assign card_body_class = 'feature-cards__card-body ' | append: bs.card_body_preset
            endif
          -%}

          <div
            class="feature-cards__card"
            role="listitem"
            style="--fcc-content-gap: {{ bs.content_gap }}px;"
            {{ block.shopify_attributes }}
          >
            {%- if bs.link != blank -%}
              <a class="feature-cards__card-link" href="{{ bs.link }}" aria-label="{{ bs.heading | escape }}">
            {%- endif -%}

            <div class="feature-cards__card-image">
              {%- if bs.image != blank -%}
                {%- assign card_alt = bs.heading | escape -%}
                {{
                  bs.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,900',
                    sizes: '(max-width: 749px) 85vw, 400px',
                    alt: card_alt,
                    class: 'feature-cards__img'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'feature-cards__img feature-cards__img--placeholder' }}
              {%- endif -%}
            </div>

            <div class="feature-cards__overlay" aria-hidden="true"></div>

            <div class="feature-cards__card-content" style="padding: {{ bs.card_padding }}px;">
              {%- if bs.label != blank -%}
                <span class="feature-cards__label">{{ bs.label | escape }}</span>
              {%- endif -%}

              <div class="feature-cards__card-text">
                {%- if bs.heading != blank -%}
                  <p class="{{ card_heading_class }}" style="{{ card_heading_style }}">{{ bs.heading | escape }}</p>
                {%- endif -%}
                {%- if bs.body != blank -%}
                  <p class="{{ card_body_class }}" style="{{ card_body_style }}">{{ bs.body | escape }}</p>
                {%- endif -%}
              </div>
            </div>

            {%- if bs.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .section-feature-cards {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 24px);
  }

  /* Section heading — padded to match page margin */
  .feature-cards__heading {
    margin: 0;
    color: var(--color, inherit);
    padding-inline: var(--page-margin, 16px);
  }

  /* Scrollable track */
  .feature-cards__track {
    display: flex;
    flex-direction: row;
    gap: var(--fcc-gap, 16px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-inline: var(--page-margin, 16px);
  }

  .feature-cards__track::-webkit-scrollbar {
    display: none;
  }

  /* Card — fixed width, never shrinks */
  .feature-cards__card {
    position: relative;
    width: var(--fcc-card-width, 380px);
    flex: 0 0 auto;
    height: var(--fcc-card-height, 580px);
    border-radius: var(--fcc-card-radius, 12px);
    overflow: hidden;
    scroll-snap-align: start;
  }

  /* Linked card reset */
  .feature-cards__card-link {
    display: contents;
    text-decoration: none;
    color: inherit;
  }

  /* Background image */
  .feature-cards__card-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .feature-cards__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .feature-cards__img--placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.6;
  }

  /* Gradient overlay */
  .feature-cards__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      transparent 25%,
      rgba(0, 0, 0, 0.15) 55%,
      rgba(0, 0, 0, 0.70) 100%
    );
  }

  /* Content layer */
  .feature-cards__card-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Frosted glass pill label */
  .feature-cards__label {
    display: inline-block;
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: #ffffff;
    font-size: var(--fcc-label-size, 13px);
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 8px 20px;
    border-radius: 100px;
    line-height: 1;
  }

  /* Bottom text block */
  .feature-cards__card-text {
    display: flex;
    flex-direction: column;
    gap: var(--fcc-content-gap, 10px);
  }

  .feature-cards__card-heading {
    margin: 0;
    color: var(--color, #ffffff);
    line-height: 1.1;
  }

  .feature-cards__card-body {
    margin: 0;
    color: var(--color, rgba(255, 255, 255, 0.80));
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .feature-cards__card {
      width: min(var(--fcc-card-width, 380px), 80vw);
      height: 500px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-cards__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature Cards Carousel",
  "tag": "section",
  "class": "section-feature-cards-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why parents choose Mekè Baby"
    },
    {
      "type": "select",
      "id": "heading_type_preset",
      "label": "Heading style",
      "info": "Inherits font, size and weight from your theme typography settings",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
