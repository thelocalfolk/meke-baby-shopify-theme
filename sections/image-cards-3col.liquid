{% comment %}
  Section: Image Cards — 3 Column
  Three full-bleed image cards displayed in a row, each with an optional title and subtitle
  overlaid at the bottom-left. A section-level heading sits above the grid.
  Built for the Horizon theme.
{% endcomment %}

<div
  id="section-{{ section.id }}"
  class="image-cards-3col"
  style="
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="image-cards-3col__inner">

    {%- if section.settings.heading != blank -%}
      <p
        class="image-cards-3col__heading {{ section.settings.heading_preset }}"
        style="{% render 'typography-style', settings: section.settings %}"
      >
        {{ section.settings.heading | escape }}
      </p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="image-cards-3col__grid">
        {%- for block in section.blocks -%}
          <div class="image-cards-3col__card" {{ block.shopify_attributes }}>

            <div class="image-cards-3col__image-wrap">
              {%- if block.settings.image != blank -%}
                {%- assign card_alt = block.settings.title | escape -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    alt: card_alt,
                    widths: '400, 600, 800, 900',
                    sizes: '(max-width: 767px) 100vw, 33vw',
                    class: 'image-cards-3col__img'
                }}
              {%- else -%}
                <div class="image-cards-3col__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'image-cards-3col__placeholder-svg' }}
                </div>
              {%- endif -%}

              {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                <div
                  class="image-cards-3col__overlay"
                  style="background: {{ block.settings.overlay_color }};"
                >
                  {%- if block.settings.title != blank -%}
                    <p
                      class="image-cards-3col__card-title {{ block.settings.title_preset }}"
                      style="
                        color: {{ block.settings.text_color }};
                        {% render 'typography-style', settings: block.settings, prefix: 'title_' %}
                      "
                    >
                      {{ block.settings.title | escape }}
                    </p>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <p
                      class="image-cards-3col__card-subtitle {{ block.settings.subtitle_preset }}"
                      style="
                        color: {{ block.settings.text_color }};
                        {% render 'typography-style', settings: block.settings, prefix: 'subtitle_' %}
                      "
                    >
                      {{ block.settings.subtitle | escape }}
                    </p>
                  {%- endif -%}
                </div>
              {%- endif -%}

            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  #section-{{ section.id }} {
    --card-gap: {{ section.settings.card_gap }}px;
    --card-radius: {{ section.settings.card_radius }}px;
    --card-aspect: {{ section.settings.card_aspect_ratio }};
  }

  #section-{{ section.id }} .image-cards-3col__inner {
    max-width: var(--container-max-width, 1400px);
    margin: 0 auto;
    padding-left: var(--container-gutter, 24px);
    padding-right: var(--container-gutter, 24px);
  }

  #section-{{ section.id }} .image-cards-3col__heading {
    text-align: {{ section.settings.heading_alignment }};
    margin: 0 0 {{ section.settings.heading_gap }}px;
    color: {{ section.settings.heading_color }};
  }

  #section-{{ section.id }} .image-cards-3col__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--card-gap);
  }

  #section-{{ section.id }} .image-cards-3col__image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--card-radius);
    aspect-ratio: var(--card-aspect);
  }

  #section-{{ section.id }} .image-cards-3col__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  #section-{{ section.id }} .image-cards-3col__card:hover .image-cards-3col__img {
    transform: scale(1.03);
  }

  #section-{{ section.id }} .image-cards-3col__placeholder,
  #section-{{ section.id }} .image-cards-3col__placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #section-{{ section.id }} .image-cards-3col__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ section.settings.overlay_padding }}px;
  }

  #section-{{ section.id }} .image-cards-3col__card-title,
  #section-{{ section.id }} .image-cards-3col__card-subtitle {
    margin: 0;
    line-height: 1.2;
  }

  #section-{{ section.id }} .image-cards-3col__card-title {
    margin-bottom: 4px;
  }

  /* Mobile — stack to single column */
  @media (max-width: 767px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #section-{{ section.id }} .image-cards-3col__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
