      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards (desktop)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_card_gap",
      "label": "Gap between cards (mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "16 / 9", "label": "16:9 — Landscape wide" },
        { "value": "4 / 3", "label": "4:3 — Landscape" },
        { "value": "3 / 2", "label": "3:2 — Landscape" },
        { "value": "1 / 1", "label": "1:1 — Square" },
        { "value": "2 / 3", "label": "2:3 — Portrait" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Padding inside card",
      "min": 8,
      "max": 60,
      "step": 4,
      "default": 28,
      "unit": "px",
      "info": "Distance the text sits from the card edges."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 55,
      "unit": "%",
