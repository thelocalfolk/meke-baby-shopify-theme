{% comment %}
  Section: Collection Card Grid
  Theme: Horizon (Meke Baby)
  A responsive grid of collection cards — each card has an image, heading,
  description, and optional button. Heading + description sit OVER the
  image at the bottom-left with a soft gradient overlay for legibility
  (same pattern as feature-cards-masonry).
  Each card is a separate block configured fully in the theme editor.

  Includes an optional centred section heading above the grid, and
  schema-driven horizontal (edge) padding so the section pulls in from
  the page edges.
{% endcomment %}

<div
  id="section-{{ section.id }}"
  class="collection-card-grid"
  style="
    background-color: {{ section.settings.background_colour }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_horizontal }}px;
    padding-right: {{ section.settings.padding_horizontal }}px;
  "
>
  {{- '<!-- Section heading -->' -}}
  {%- if section.settings.heading != blank -%}
    <div class="collection-card-grid__header collection-card-grid__header--{{ section.settings.heading_alignment }}">
      <p
        class="collection-card-grid__section-heading {{ section.settings.type_preset }}"
        style="{% render 'typography-style', settings: section.settings %} color: {{ section.settings.section_heading_colour }};"
      >
        {{ section.settings.heading | escape }}
      </p>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="collection-card-grid__grid">
        {%- for block in section.blocks -%}
          {%- assign card_image_alt = block.settings.heading | escape -%}

          <div class="collection-card-grid__card" {{ block.shopify_attributes }}>

            {{- '<!-- Image fills the card -->' -}}
            <div class="collection-card-grid__image-wrap">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    alt: card_image_alt,
                    widths: '400, 600, 800, 1000, 1200, 1400',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    class: 'collection-card-grid__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-card-grid__image collection-card-grid__image--placeholder' }}
              {%- endif -%}
            </div>

            {{- '<!-- Gradient overlay for text legibility -->' -}}
            <div class="collection-card-grid__overlay" aria-hidden="true"></div>

            {{- '<!-- Text content overlaid on image -->' -}}
            <div class="collection-card-grid__content">

              {%- if block.settings.heading != blank -%}
                <p
                  class="collection-card-grid__heading {{ block.settings.type_preset }}"
                  style="{% render 'typography-style', settings: block.settings %}"
                >
                  {{ block.settings.heading | escape }}
                </p>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="collection-card-grid__description">
                  {{ block.settings.description | escape }}
                </p>
              {%- endif -%}

              {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
                <div class="collection-card-grid__button-wrap">
                  <a
                    href="{{ block.settings.button_url }}"
                    class="collection-card-grid__button"
                    style="
                      background-color: {{ section.settings.button_background }};
                      color: {{ section.settings.button_text_colour }};
                      border-radius: {{ section.settings.button_border_radius }}px;
                    "
                  >
                    {{ block.settings.button_label | escape }}
                  </a>
                </div>
              {%- endif -%}

            </div>
          </div>
        {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% comment %} Liquid-dependent styles — grid, spacing, aspect ratio {% endcomment %}
<style>
  #section-{{ section.id }} .collection-card-grid__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
  }

  #section-{{ section.id }} .collection-card-grid__card {
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  #section-{{ section.id }} .collection-card-grid__overlay {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 35%,
      rgba(0, 0, 0, {{ section.settings.overlay_opacity | times: 0.01 }}) 100%
    );
  }

  #section-{{ section.id }} .collection-card-grid__heading {
    margin: 0;
    color: {{ section.settings.heading_colour }};
  }

  #section-{{ section.id }} .collection-card-grid__description {
    margin: 0;
    color: {{ section.settings.heading_colour }};
    opacity: 0.9;
  }

  #section-{{ section.id }} .collection-card-grid__content {
    padding: {{ section.settings.content_gap }}px;
  }

  #section-{{ section.id }} .collection-card-grid__button-wrap {
    margin-top: {{ section.settings.button_top_gap }}px;
  }

  #section-{{ section.id }} .collection-card-grid__button {
    padding: {{ section.settings.button_padding_v }}px {{ section.settings.button_padding_h }}px;
  }

  #section-{{ section.id }} .collection-card-grid__header {
    margin-bottom: {{ section.settings.heading_bottom_gap }}px;
  }

  @media screen and (max-width: 749px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: {{ section.settings.mobile_padding_horizontal }}px;
      padding-right: {{ section.settings.mobile_padding_horizontal }}px;
    }

    #section-{{ section.id }} .collection-card-grid__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_card_gap }}px;
    }

    #section-{{ section.id }} .collection-card-grid__header {
      margin-bottom: {{ section.settings.mobile_heading_bottom_gap }}px;
    }
  }
</style>

{% comment %} Static layout styles {% endcomment %}
{% stylesheet %}
  .collection-card-grid__header {
    width: 100%;
  }

  .collection-card-grid__header--left {
    text-align: left;
  }

  .collection-card-grid__header--center {
    text-align: center;
  }

  .collection-card-grid__header--right {
    text-align: right;
  }

  .collection-card-grid__section-heading {
    margin: 0;
  }

  .collection-card-grid__card {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .collection-card-grid__image-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .collection-card-grid__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection-card-grid__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }

  .collection-card-grid__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .collection-card-grid__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 8px;
  }

  .collection-card-grid__button {
    display: inline-block;
    text-decoration: none;
    font-size: inherit;
    line-height: 1;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .collection-card-grid__button:hover {
    opacity: 0.85;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Card Grid",
  "tag": "section",
  "class": "collection-card-grid-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fits seamlessly into your routine"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Heading style",
      "info": "Inherits from your theme typography settings",
      "options": [
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
