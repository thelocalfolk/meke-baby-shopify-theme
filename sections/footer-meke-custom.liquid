{% comment %}
  Section: Meke Baby Footer
  Custom footer for the Meke Baby store — Horizon theme.
  Includes: centred logo, 4-column grid (3 nav menus + email signup with social icons),
  IP/legal richtext block, and bottom bar with copyright and designer credit.
  All content is merchant-editable via the Theme Editor.
{% endcomment %}

{%- liquid
  assign menu_1_list = linklists[section.settings.menu_1]
  assign menu_2_list = linklists[section.settings.menu_2]
  assign menu_3_list = linklists[section.settings.menu_3]
-%}

<footer
  id="section-{{ section.id }}"
  class="mb-footer color-{{ section.settings.color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="mb-footer__inner section--page-width">

    {%- comment -%} ── Logo ── {%- endcomment -%}
    <div class="mb-footer__logo-wrap">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'eager', alt: logo_alt, class: 'mb-footer__logo-img' }}
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="mb-footer__shop-name">{{ shop.name | escape }}</a>
      {%- endif -%}
    </div>

    {%- comment -%} ── 4-column grid ── {%- endcomment -%}
    <div class="mb-footer__main">

      {%- comment -%} Nav column 1 {%- endcomment -%}
      {%- if menu_1_list.links.size > 0 -%}
        <div class="mb-footer__nav-col">
          <button class="mb-footer__nav-toggle" aria-expanded="false">
            {%- if section.settings.menu_1_heading != blank -%}
              <span class="mb-footer__nav-heading">{{ section.settings.menu_1_heading | escape }}</span>
            {%- endif -%}
            <span class="mb-footer__nav-chevron" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>
            </span>
          </button>
          <ul class="mb-footer__nav-list">
            {%- for link in menu_1_list.links -%}
              <li>
                <a href="{{ link.url }}" class="mb-footer__nav-link">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%} Nav column 2 {%- endcomment -%}
      {%- if menu_2_list.links.size > 0 -%}
        <div class="mb-footer__nav-col">
          <button class="mb-footer__nav-toggle" aria-expanded="false">
            {%- if section.settings.menu_2_heading != blank -%}
              <span class="mb-footer__nav-heading">{{ section.settings.menu_2_heading | escape }}</span>
            {%- endif -%}
            <span class="mb-footer__nav-chevron" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>
            </span>
          </button>
          <ul class="mb-footer__nav-list">
            {%- for link in menu_2_list.links -%}
              <li>
                <a href="{{ link.url }}" class="mb-footer__nav-link">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%} Nav column 3 {%- endcomment -%}
      {%- if menu_3_list.links.size > 0 -%}
        <div class="mb-footer__nav-col">
          <button class="mb-footer__nav-toggle" aria-expanded="false">
            {%- if section.settings.menu_3_heading != blank -%}
              <span class="mb-footer__nav-heading">{{ section.settings.menu_3_heading | escape }}</span>
            {%- endif -%}
            <span class="mb-footer__nav-chevron" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>
            </span>
          </button>
          <ul class="mb-footer__nav-list">
            {%- for link in menu_3_list.links -%}
              <li>
                <a href="{{ link.url }}" class="mb-footer__nav-link">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%} Email signup + social column {%- endcomment -%}
      <div class="mb-footer__signup-col">

        {%- if section.settings.signup_heading != blank -%}
          <p class="mb-footer__signup-heading">{{ section.settings.signup_heading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.signup_subtext != blank -%}
          <p class="mb-footer__signup-subtext">{{ section.settings.signup_subtext | escape }}</p>
        {%- endif -%}

        {%- form 'customer', id: 'mb-footer-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="mb-footer__form-row">
            <input
              type="email"
              name="contact[email]"
              id="mb-footer-email"
              class="mb-footer__email-input"
              placeholder="{{ section.settings.email_placeholder | default: 'Email' | escape }}"
              autocomplete="email"
              aria-label="{{ section.settings.email_placeholder | default: 'Email' | escape }}"
              required
            >
            <button type="submit" class="mb-footer__signup-btn">
              {{ section.settings.signup_button_label | default: 'Sign Up' | escape }}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="mb-footer__form-success">Thanks for subscribing!</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="mb-footer__form-error">Please enter a valid email address.</p>
          {%- endif -%}
        {%- endform -%}

        {%- comment -%} Social icons {%- endcomment -%}
        <div class="mb-footer__social">
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="mb-footer__social-link">
              <svg class="mb-footer__social-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                {%- render 'icon', icon: 'instagram' -%}
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="mb-footer__social-link">
              <svg class="mb-footer__social-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                {%- render 'icon', icon: 'facebook' -%}
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="mb-footer__social-link">
              <svg class="mb-footer__social-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                {%- render 'icon', icon: 'tiktok' -%}
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_pinterest != blank -%}
            <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest" class="mb-footer__social-link">
              <svg class="mb-footer__social-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                {%- render 'icon', icon: 'pinterest' -%}
              </svg>
            </a>
          {%- endif -%}
        </div>

      </div>
    </div>

    {%- comment -%} ── Legal / IP block ── {%- endcomment -%}
    {%- if section.settings.legal_text != blank -%}
      <div class="mb-footer__legal">
        {{ section.settings.legal_text }}
      </div>
    {%- endif -%}

    {%- comment -%} ── Bottom bar ── {%- endcomment -%}
    <div class="mb-footer__bottom">
      <p class="mb-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}. {{ shop.name | escape }}. {{ section.settings.copyright_text | default: 'All rights reserved.' | escape }}
      </p>
      {%- if section.settings.designer_name != blank -%}
        <p class="mb-footer__designer">
          {%- if section.settings.designer_prefix != blank -%}
            {{ section.settings.designer_prefix | escape }}
          {%- endif -%}
          {%- if section.settings.designer_url != blank -%}
            <a href="{{ section.settings.designer_url }}" target="_blank" rel="noopener noreferrer">{{ section.settings.designer_name | escape }}</a>
          {%- else -%}
            {{ section.settings.designer_name | escape }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

  </div>
</footer>

{% stylesheet %}
  #section-{{ section.id }}.mb-footer {
    width: 100%;
  }

  #section-{{ section.id }} .mb-footer__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding-inline: var(--container-gutter, 2rem);
  }

  /* ── Logo ── */
  #section-{{ section.id }} .mb-footer__logo-wrap {
    display: flex;
    justify-content: center;
    padding-bottom: 3rem;
  }

  #section-{{ section.id }} .mb-footer__logo-img {
    max-width: 200px;
    height: auto;
  }

  #section-{{ section.id }} .mb-footer__shop-name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: currentColor;
    text-decoration: none;
  }

  /* ── 4-column grid ── */
  #section-{{ section.id }} .mb-footer__main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 4rem;
  }

  @media screen and (min-width: 750px) {
    #section-{{ section.id }} .mb-footer__main {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    #section-{{ section.id }} .mb-footer__main {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  /* ── Nav columns ── */  #section-{{ section.id }} .mb-footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  #section-{{ section.id }} .mb-footer__nav-link {
    font-size: 0.875rem;
    color: currentColor;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  #section-{{ section.id }} .mb-footer__nav-link:hover {
    opacity: 1;
  }

  /* ── Email signup column ── */
  #section-{{ section.id }} .mb-footer__signup-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #section-{{ section.id }} .mb-footer__signup-heading {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: currentColor;
  }

  #section-{{ section.id }} .mb-footer__signup-subtext {
    font-size: 0.875rem;
    margin: 0;
    opacity: 0.8;
    color: currentColor;
  }

  #section-{{ section.id }} .mb-footer__form-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  #section-{{ section.id }} .mb-footer__email-input {
    flex: 1;
    border: none;
    background: var(--color-input-background, #fff);
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    color: var(--color-input-text, #111);
    outline: none;
    min-width: 0;
    border-radius: var(--style-border-radius-pills, 100px);
  }

  #section-{{ section.id }} .mb-footer__email-input::placeholder {
    color: var(--color-input-text, #111);
    opacity: 0.5;
  }

  #section-{{ section.id }} .mb-footer__signup-btn {
    border: none;
    cursor: pointer;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: var(--style-border-radius-pills, 100px);
    background-color: var(--color-secondary-button-background);
    color: var(--color-secondary-button-text);
    border: 1px solid var(--color-secondary-button-border);
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  #section-{{ section.id }} .mb-footer__signup-btn:hover {
    background-color: var(--color-secondary-button-hover-background);
    color: var(--color-secondary-button-hover-text);
    border-color: var(--color-secondary-button-hover-border);
    opacity: 1;
  }

  #section-{{ section.id }} .mb-footer__form-success,
  #section-{{ section.id }} .mb-footer__form-error {
    font-size: 0.8125rem;
    margin: 0.5rem 0 0;
  }

  #section-{{ section.id }} .mb-footer__form-success {
    opacity: 0.8;
  }

  #section-{{ section.id }} .mb-footer__form-error {
    color: var(--color-error, #8B0000);
  }

  /* ── Social icons ── */
  #section-{{ section.id }} .mb-footer__social {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
  }

  #section-{{ section.id }} .mb-footer__social-link {
    color: currentColor;
    opacity: 0.8;
    transition: opacity 0.2s ease;
    display: flex;
    align-items: center;
  }

  #section-{{ section.id }} .mb-footer__social-link:hover {
    opacity: 1;
  }

  #section-{{ section.id }} .mb-footer__social-icon {
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }

  /* ── Legal block ── */
  #section-{{ section.id }} .mb-footer__legal {
    padding-bottom: 3rem;
    font-size: 0.75rem;
    line-height: 1.7;
    opacity: 0.7;
    max-width: 600px;
  }

  #section-{{ section.id }} .mb-footer__legal p {
    margin: 0 0 0.5rem;
  }

  /* ── Bottom bar ── */
  #section-{{ section.id }} .mb-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px solid currentColor;
    border-top-color: rgba(255, 255, 255, 0.15);
    padding-top: 1.5rem;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  @media screen and (min-width: 750px) {
    #section-{{ section.id }} .mb-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  #section-{{ section.id }} .mb-footer__copyright,
  #section-{{ section.id }} .mb-footer__designer {
    margin: 0;
  }

  #section-{{ section.id }} .mb-footer__designer a {
    color: currentColor;
    text-decoration: underline;
  }

  /* ── Mobile nav accordion ── */
  @media screen and (max-width: 749px) {
    #section-{{ section.id }} .mb-footer__nav-toggle {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      background: none;
      border: none;
      border-bottom: 1px solid currentColor;
      padding: 0.75rem 0;
      cursor: pointer;
      color: currentColor;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1;
    }

    #section-{{ section.id }} .mb-footer__nav-heading {
      margin: 0;
      line-height: 1;
      font-size: 0.875rem;
      font-weight: 600;
      color: currentColor;
    }

    #section-{{ section.id }} .mb-footer__nav-list {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    #section-{{ section.id }} .mb-footer__nav-col.is-open .mb-footer__nav-list {
      max-height: 500px;
      padding: 0.5rem 0;
    }

    #section-{{ section.id }} .mb-footer__nav-chevron {
      transition: transform 0.3s ease;
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    #section-{{ section.id }} .mb-footer__nav-col.is-open .mb-footer__nav-chevron {
      transform: rotate(180deg);
    }

    #section-{{ section.id }} .mb-footer__signup-col {
      margin-top: 2.5rem;
    }
  }

  @media screen and (min-width: 750px) {
    #section-{{ section.id }} .mb-footer__nav-toggle {
      display: contents;
      font-weight: inherit;
      color: inherit;
    }

    #section-{{ section.id }} .mb-footer__nav-heading {
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      margin: 0 0 1.5rem;
      color: currentColor;
    }

    #section-{{ section.id }} .mb-footer__nav-chevron {
      display: none;
    }
  }
  @media screen and (max-width: 749px) {
    #section-{{ section.id }} .mb-footer__main {
      gap: 0;
    }
    #section-{{ section.id }}.mb-footer {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    function initFooterAccordions() {
      var section = document.getElementById('section-{{ section.id }}');
      if (!section) return;

      var toggles = section.querySelectorAll('.mb-footer__nav-toggle');

      toggles.forEach(function (toggle) {
        toggle.addEventListener('click', function () {
          var col = toggle.closest('.mb-footer__nav-col');
          var isOpen = col.classList.contains('is-open');

          // Close all
          section.querySelectorAll('.mb-footer__nav-col').forEach(function (c) {
            c.classList.remove('is-open');
            c.querySelector('.mb-footer__nav-toggle').setAttribute('aria-expanded', 'false');
          });

          // Open clicked if it was closed
          if (!isOpen) {
            col.classList.add('is-open');
            toggle.setAttribute('aria-expanded', 'true');
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFooterAccordions);
    } else {
      initFooterAccordions();
    }
  })();
</script>

