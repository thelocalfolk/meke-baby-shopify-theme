{%- liquid
  assign section_settings = section.settings
  assign blocks = section.blocks
  assign block_count = blocks.size

  if section_settings.section_width == 'page-width'
    assign slideshow_gutters = 'start end'
    assign gutter_style = '--gutter-slide-width: var(--util-page-margin-offset);'
  else
    assign slideshow_gutters = null
    assign gutter_style = '--gutter-slide-width: 0px;'
  endif

  assign show_arrows = false
  if section_settings.icons_style != 'none'
    assign show_arrows = true
  endif
-%}

<div class="section-background color-{{ section_settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section_settings.section_width }}
    color-{{ section_settings.color_scheme }}
    section-video-feedback
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section_settings %}
    --vfc-columns-desktop: {{ section_settings.columns }};
    --vfc-columns-mobile: {{ section_settings.mobile_columns }};
    --vfc-gap: {{ section_settings.columns_gap }}px;
    --vfc-card-radius: {{ section_settings.card_radius }}px;
    --vfc-aspect-ratio: {{ section_settings.aspect_ratio }};
  "
  data-testid="video-feedback-carousel"
>
  {%- if section_settings.heading != blank or section_settings.subheading != blank -%}
    {%- liquid
      # Build inline custom-typography styles for heading
      assign heading_style = ''
      if section_settings.heading_color != blank and section_settings.heading_color != ''
        assign heading_style = heading_style | append: '--color: ' | append: section_settings.heading_color | append: ';'
      endif
      if section_settings.heading_type_preset == 'custom'
        assign h_font_weight = section_settings.heading_font | replace: 'family', 'weight'
        assign heading_style = heading_style | append: '--font-family: ' | append: section_settings.heading_font | append: ';'
        assign heading_style = heading_style | append: '--font-weight: ' | append: h_font_weight | append: ';'
        assign heading_style = heading_style | append: '--font-size: ' | append: section_settings.heading_font_size | append: ';'
        assign heading_style = heading_style | append: '--text-transform: ' | append: section_settings.heading_case | append: ';'
        assign heading_style = heading_style | append: '--line-height: var(--line-height--heading-' | append: section_settings.heading_line_height | append: ');'
        assign heading_style = heading_style | append: '--letter-spacing: var(--letter-spacing--heading-' | append: section_settings.heading_letter_spacing | append: ');'
      endif

      # Determine class list for heading - use the preset name as a class for non-custom
      assign heading_class = 'video-feedback__heading'
      if section_settings.heading_type_preset == 'custom'
        assign heading_class = heading_class | append: ' custom-typography custom-font-size'
      else
        assign heading_class = heading_class | append: ' ' | append: section_settings.heading_type_preset
      endif

      # Build inline custom-typography styles for subheading
      assign subheading_style = ''
      if section_settings.subheading_color != blank and section_settings.subheading_color != ''
        assign subheading_style = subheading_style | append: '--color: ' | append: section_settings.subheading_color | append: ';'
      endif
      if section_settings.subheading_type_preset == 'custom'
        assign s_font_weight = section_settings.subheading_font | replace: 'family', 'weight'
        assign subheading_style = subheading_style | append: '--font-family: ' | append: section_settings.subheading_font | append: ';'
        assign subheading_style = subheading_style | append: '--font-weight: ' | append: s_font_weight | append: ';'
        assign subheading_style = subheading_style | append: '--font-size: ' | append: section_settings.subheading_font_size | append: ';'
        assign subheading_style = subheading_style | append: '--text-transform: ' | append: section_settings.subheading_case | append: ';'
        assign subheading_style = subheading_style | append: '--line-height: var(--line-height--body-' | append: section_settings.subheading_line_height | append: ');'
        assign subheading_style = subheading_style | append: '--letter-spacing: var(--letter-spacing--body-' | append: section_settings.subheading_letter_spacing | append: ');'
      endif

      assign subheading_class = 'video-feedback__subheading'
      if section_settings.subheading_type_preset == 'custom'
        assign subheading_class = subheading_class | append: ' custom-typography custom-font-size'
      else
        assign subheading_class = subheading_class | append: ' ' | append: section_settings.subheading_type_preset
      endif
    -%}
    <header class="video-feedback__header video-feedback__header--{{ section_settings.text_alignment }}">
      {%- if section_settings.heading != blank -%}
        <h2 class="{{ heading_class }}" style="{{ heading_style }}">
          {{ section_settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section_settings.subheading != blank -%}
        <p class="{{ subheading_class }}" style="{{ subheading_style }}">
          {{ section_settings.subheading }}
        </p>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- if block_count > 0 -%}
    {%- capture slides -%}
      {%- for block in blocks -%}
        {%- liquid
          assign b = block.settings
          assign has_uploaded = false
          assign has_url = false
          if b.video != blank
            assign has_uploaded = true
          elsif b.video_url != blank
            assign has_url = true
          endif

          # Pick a poster image. Prefer the merchant's cover image, fall back to the video's own preview frame.
          assign poster_image = b.cover_image | default: b.video.preview_image
        -%}
        {%- capture slide_inner -%}
          <article class="vfc-card" data-vfc-card data-vfc-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="vfc-card__media">
              {%- if has_uploaded -%}
                {%- comment -%}
                  Render <video> directly (not via deferred-media) so we can play/pause it
                  programmatically the moment it becomes the centered slide.
                {%- endcomment -%}
                <video
                  class="vfc-card__video"
                  data-vfc-video
                  playsinline
                  muted
                  {% if section_settings.loop_videos %}loop{% endif %}
                  {% unless section_settings.center_play %}controls{% endunless %}
                  preload="metadata"
                  {% if poster_image != blank %}
                    poster="{{ poster_image | image_url: width: 1200 }}"
                  {% endif %}
                >
                  {%- for source in b.video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
              {%- elsif has_url -%}
                {%- comment -%}
                  External videos (YouTube/Vimeo): keep deferred-media because we can't
                  reliably autoplay-with-sound through cross-origin iframes.
                {%- endcomment -%}
                {%- render 'video',
                  video_from_url: true,
                  video: b.video_url.id,
                  video_type: b.video_url.type,
                  video_autoplay: false,
                  video_loop: section_settings.loop_videos,
                  video_class: 'vfc-card__video vfc-card__video--external',
                  video_preview_image: b.cover_image,
                  video_alt: b.name
                -%}
              {%- else -%}
                <div class="vfc-card__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'vfc-card__placeholder-svg' }}
                </div>
              {%- endif -%}

              {%- if has_uploaded and section_settings.center_play -%}
                {%- comment -%} Mute toggle - shown only on the centered card via CSS {%- endcomment -%}
                <button
                  type="button"
                  class="vfc-card__mute-toggle"
                  data-vfc-mute-toggle
                  aria-label="{{ 'accessibility.toggle_audio' | t: default: 'Toggle audio' }}"
                  aria-pressed="true"
                >
                  <span class="vfc-card__mute-icon vfc-card__mute-icon--muted" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                      <line x1="23" y1="9" x2="17" y2="15"></line>
                      <line x1="17" y1="9" x2="23" y2="15"></line>
                    </svg>
                  </span>
                  <span class="vfc-card__mute-icon vfc-card__mute-icon--unmuted" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                      <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                      <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                    </svg>
                  </span>
                </button>
              {%- endif -%}
            </div>

            {%- if b.name != blank or b.location != blank or b.caption != blank -%}
              <div class="vfc-card__content">
                {%- if b.caption != blank -%}
                  <p class="vfc-card__caption">{{ b.caption }}</p>
                {%- endif -%}
                {%- if b.name != blank -%}
                  <p class="vfc-card__name">{{ b.name }}</p>
                {%- endif -%}
                {%- if b.location != blank -%}
                  <p class="vfc-card__location">{{ b.location }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </article>
        {%- endcapture -%}

        {%- render 'slideshow-slide',
          index: forloop.index0,
          children: slide_inner,
          class: 'vfc-slide'
        -%}
      {%- endfor -%}
    {%- endcapture -%}

    <video-feedback-carousel
      class="vfc-carousel-wrap"
      style="{{ gutter_style }}"
      data-center-play="{{ section_settings.center_play }}"
    >
      {%- render 'slideshow',
        ref: 'videoFeedbackCarousel',
        class: 'vfc-carousel',
        slides: slides,
        slide_count: block_count,
        show_arrows: show_arrows,
        icon_style: section_settings.icons_style,
        icon_shape: section_settings.icons_shape,
        auto_hide_controls: false,
        infinite: section_settings.infinite,
        initial_slide: 0,
        slideshow_gutters: slideshow_gutters
      -%}
    </video-feedback-carousel>
  {%- else -%}
    <p class="vfc-empty">{{ 'onboarding.no_content' | t: default: 'Add testimonial blocks to get started.' }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .section-video-feedback {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg, 32px);
  }

  .video-feedback__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 12px);
    padding-inline: var(--page-margin, 16px);
  }

  .video-feedback__header--left {
    align-items: flex-start;
    text-align: left;
  }

  .video-feedback__header--center {
    align-items: center;
    text-align: center;
  }

  .video-feedback__header--right {
    align-items: flex-end;
    text-align: right;
  }

  .video-feedback__heading {
    margin: 0;
    color: var(--color, inherit);
  }

  .video-feedback__subheading {
    margin: 0;
    color: var(--color, rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.7)));
    max-width: 60ch;
  }

  .video-feedback__header--center .video-feedback__subheading {
    margin-inline: auto;
  }

  /* Carousel wrapper */
  .vfc-carousel-wrap {
    width: 100%;
    position: relative;
    container-type: inline-size;
    container-name: video-feedback-carousel;
  }

  .vfc-carousel {
    --slide-width: clamp(220px, 70vw, 360px);
    width: 100%;
    position: relative;
  }

  .vfc-carousel slideshow-slides {
    gap: var(--vfc-gap);
    padding-block: 8px;
  }

  .vfc-slide {
    width: var(--slide-width);
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-width: 0;
  }

  /* Desktop: size slides based on column count */
  @container video-feedback-carousel (min-width: 750px) {
    .vfc-carousel .vfc-slide {
      --slide-width: calc(
        (100% - (var(--vfc-gap) * (var(--vfc-columns-desktop) - 1))) /
          var(--vfc-columns-desktop)
      );
    }
  }

  /* Mobile column behaviour */
  @container video-feedback-carousel (max-width: 749px) {
    .vfc-carousel .vfc-slide {
      --slide-width: calc(
        (100% - (var(--vfc-gap) * (var(--vfc-columns-mobile) - 1)) - 32px) /
          var(--vfc-columns-mobile)
      );
    }
  }

  /* Card */
  .vfc-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    height: 100%;
  }

  .vfc-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--vfc-aspect-ratio, 9 / 16);
    border-radius: var(--vfc-card-radius, 12px);
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .vfc-card__video,
  .vfc-card__media video,
  .vfc-card__media iframe,
  .vfc-card__media deferred-media,
  .vfc-card__media img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    border-radius: inherit;
    display: block;
  }

  .vfc-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vfc-card__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .vfc-card__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-inline: 4px;
  }

  .vfc-card__caption {
    font-size: var(--font-paragraph-size, 1rem);
    margin: 0 0 4px;
  }

  .vfc-card__name {
    font-weight: 600;
    margin: 0;
  }

  .vfc-card__location {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.7));
    font-size: 0.875em;
  }

  .vfc-empty {
    text-align: center;
    padding: 48px 16px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.6));
  }

  /* Hide arrows when at boundaries (Horizon already handles the disabled state) */
  .vfc-carousel slideshow-arrows {
    padding-inline: var(--util-page-margin-offset);
  }

  .vfc-carousel .slideshow-control[disabled] {
    opacity: 0.3;
  }

  /* Mute toggle button - hidden by default, shown only on the active centered card */
  .vfc-card__mute-toggle {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    border: none;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    z-index: 2;
    transition: background-color 0.2s ease, opacity 0.2s ease;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .vfc-card__mute-toggle:hover,
  .vfc-card__mute-toggle:focus-visible {
    background: rgb(0 0 0 / 0.75);
  }

  .vfc-card__mute-toggle svg {
    width: 18px;
    height: 18px;
  }

  /* Show the appropriate icon based on aria-pressed (true = muted) */
  .vfc-card__mute-toggle[aria-pressed='true'] .vfc-card__mute-icon--unmuted,
  .vfc-card__mute-toggle[aria-pressed='false'] .vfc-card__mute-icon--muted {
    display: none;
  }

  /* Only show the toggle on the active (centered) card */
  .vfc-card[data-vfc-active='true'] .vfc-card__mute-toggle {
    display: flex;
  }

  /* Subtle visual hint that the active card is the one playing - cursor only */
  .vfc-card[data-vfc-active='true'] {
    cursor: default;
  }

  /* Make non-active video posters slightly more prominent so they read as paused */
  .vfc-card:not([data-vfc-active='true']) .vfc-card__video {
    /* No size change as requested - just keep video paused via JS */
  }
{% endstylesheet %}

<script type="module">
  /**
   * VideoFeedbackCarousel
   * --------------------
   * Wraps the slideshow component and ensures that the card whose center is
   * closest to the viewport center is the only one playing its video.
   *
   * Behaviour:
   *  - On first interaction (or visibility), the centered card's video plays muted.
   *  - The mute toggle on the active card unmutes/mutes; this preference persists
   *    across slide changes within the session.
   *  - When the carousel scrolls out of viewport, all videos pause.
   */
  if (!customElements.get('video-feedback-carousel')) {
    class VideoFeedbackCarousel extends HTMLElement {
      constructor() {
        super();
        this._activeCard = null;
        this._userMuted = true; // start muted; honour autoplay policies
        this._inViewport = false;
        this._rafId = null;
      }

      connectedCallback() {
        // Allow the slideshow component to upgrade and render first
        requestAnimationFrame(() => this._init());
      }

      disconnectedCallback() {
        if (this._scrollHandler) {
          this._scroller?.removeEventListener('scroll', this._scrollHandler);
        }
        if (this._intersectionObserver) {
          this._intersectionObserver.disconnect();
        }
        if (this._rafId) cancelAnimationFrame(this._rafId);
      }

      _init() {
        // Allow merchants to disable the center-play behaviour
        if (this.dataset.centerPlay === 'false') return;

        this._slideshow = this.querySelector('slideshow-component');
        this._scroller = this.querySelector('slideshow-slides');
        this._cards = Array.from(this.querySelectorAll('[data-vfc-card]'));

        if (!this._scroller || !this._cards.length) return;

        // Recompute center on scroll (debounced to RAF)
        this._scrollHandler = () => {
          if (this._rafId) return;
          this._rafId = requestAnimationFrame(() => {
            this._rafId = null;
            this._updateActiveCard();
          });
        };
        this._scroller.addEventListener('scroll', this._scrollHandler, { passive: true });

        // Wire mute toggles
        this.querySelectorAll('[data-vfc-mute-toggle]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            this._userMuted = !this._userMuted;
            this._applyMuteState();
            this._updateMuteButtons();
          });
        });

        // Pause all videos when the carousel leaves the viewport
        this._intersectionObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              this._inViewport = entry.isIntersecting;
              if (!this._inViewport) {
                this._pauseAllVideos();
              } else {
                this._updateActiveCard();
              }
            }
          },
          { threshold: 0.25 }
        );
        this._intersectionObserver.observe(this);

        // Recompute on resize (column count may change)
        this._resizeObserver = new ResizeObserver(() => this._updateActiveCard());
        this._resizeObserver.observe(this);

        // Initial computation
        this._updateActiveCard();
      }

      _updateActiveCard() {
        if (!this._inViewport) return;
        const scrollerRect = this._scroller.getBoundingClientRect();
        const scrollerCenter = scrollerRect.left + scrollerRect.width / 2;

        let closestCard = null;
        let smallestDistance = Infinity;

        for (const card of this._cards) {
          const rect = card.getBoundingClientRect();
          // Only consider cards that are actually within the scroller viewport
          if (rect.right < scrollerRect.left || rect.left > scrollerRect.right) continue;
          const cardCenter = rect.left + rect.width / 2;
          const distance = Math.abs(cardCenter - scrollerCenter);
          if (distance < smallestDistance) {
            smallestDistance = distance;
            closestCard = card;
          }
        }

        if (closestCard && closestCard !== this._activeCard) {
          this._setActiveCard(closestCard);
        }
      }

      _setActiveCard(card) {
        // Pause whatever was playing
        if (this._activeCard) {
          this._activeCard.removeAttribute('data-vfc-active');
          const prevVideo = this._activeCard.querySelector('[data-vfc-video]');
          if (prevVideo) {
            prevVideo.pause();
          }
        }

        this._activeCard = card;
        card.setAttribute('data-vfc-active', 'true');

        const video = card.querySelector('[data-vfc-video]');
        if (video) {
          video.muted = this._userMuted;
          // play() returns a promise; if it rejects (e.g. unmuted autoplay blocked)
          // we fall back to muted playback so the video still starts.
          const playPromise = video.play();
          if (playPromise && typeof playPromise.catch === 'function') {
            playPromise.catch(() => {
              if (!video.muted) {
                video.muted = true;
                this._userMuted = true;
                this._updateMuteButtons();
                video.play().catch(() => {});
              }
            });
          }
        }

        this._updateMuteButtons();
      }

      _applyMuteState() {
        if (!this._activeCard) return;
        const video = this._activeCard.querySelector('[data-vfc-video]');
        if (video) video.muted = this._userMuted;
      }

      _updateMuteButtons() {
        this.querySelectorAll('[data-vfc-mute-toggle]').forEach((btn) => {
          btn.setAttribute('aria-pressed', String(this._userMuted));
        });
      }

      _pauseAllVideos() {
        this.querySelectorAll('[data-vfc-video]').forEach((v) => v.pause());
      }
    }

    customElements.define('video-feedback-carousel', VideoFeedbackCarousel);
  }
</script>

{% schema %}
{
  "name": "Video feedback carousel",
  "tag": "section",
  "class": "section-video-feedback-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real feedback from real families"
    },
    {
      "type": "select",
      "id": "heading_type_preset",
      "label": "Heading size preset",
      "info": "Use a preset from your theme's typography, or choose Custom to set a specific size below.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "var(--font-heading--family)",
      "visible_if": "{{ section.settings.heading_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading size",
      "options": [
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" },
        { "value": "1.25rem", "label": "20px" },
        { "value": "1.5rem", "label": "24px" },
        { "value": "1.75rem", "label": "28px" },
        { "value": "2rem", "label": "32px" },
        { "value": "2.5rem", "label": "40px" },
        { "value": "3rem", "label": "48px" },
        { "value": "3.5rem", "label": "56px" },
        { "value": "4.5rem", "label": "72px" },
        { "value": "5.5rem", "label": "88px" },
        { "value": "7.5rem", "label": "120px" }
      ],
      "default": "2.5rem",
      "visible_if": "{{ section.settings.heading_type_preset == 'custom' }}"
    },
    {
