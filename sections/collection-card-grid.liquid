{% comment %}
  Section: Collection Card Grid
  Theme: Horizon (Meke Baby)
  A responsive grid of collection cards — each card has an image, heading,
  description, and a button linking to any collection or custom URL.
  Each card is a separate block configured fully in the theme editor.
{% endcomment %}

<section
  id="section-{{ section.id }}"
  class="collection-card-grid"
  style="
    background-color: {{ section.settings.background_colour }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="collection-card-grid__inner page-width">
    {%- if section.blocks.size > 0 -%}
      <div
        class="collection-card-grid__grid"
        style="
          --cgrid-columns: {{ section.settings.columns }};
          --cgrid-gap: {{ section.settings.card_gap }}px;
        "
      >
        {%- for block in section.blocks -%}
          {%- assign card_image_alt = block.settings.heading | escape -%}

          <div class="collection-card-grid__card" {{ block.shopify_attributes }}>

            {{- '<!-- Image -->' -}}
            <div
              class="collection-card-grid__image-wrap"
              style="--cgrid-aspect-ratio: {{ section.settings.image_aspect_ratio }};"
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    alt: card_image_alt,
                    widths: '400, 600, 800, 1000, 1200, 1400',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    class: 'collection-card-grid__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-card-grid__image collection-card-grid__image--placeholder' }}
              {%- endif -%}
            </div>

            {{- '<!-- Text content -->' -}}
            <div class="collection-card-grid__content">

              {%- if block.settings.heading != blank -%}
                <p
                  class="collection-card-grid__heading {{ block.settings.type_preset }}"
                  style="{% render 'typography-style', settings: block.settings %}"
                >
                  {{ block.settings.heading | escape }}
                </p>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="collection-card-grid__description">
                  {{ block.settings.description | escape }}
                </p>
              {%- endif -%}

              {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
                <div class="collection-card-grid__button-wrap">
                  <a
                    href="{{ block.settings.button_url }}"
                    class="collection-card-grid__button"
                    style="
                      background-color: {{ section.settings.button_background }};
                      color: {{ section.settings.button_text_colour }};
                      border-radius: {{ section.settings.button_border_radius }}px;
                    "
                  >
                    {{ block.settings.button_label | escape }}
                  </a>
                </div>
              {%- endif -%}

            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #section-{{ section.id }} {
    width: 100%;
  }

  #section-{{ section.id }} .collection-card-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--cgrid-columns, 2), 1fr);
    gap: var(--cgrid-gap, 32px);
  }

  #section-{{ section.id }} .collection-card-grid__card {
    display: flex;
    flex-direction: column;
  }

  #section-{{ section.id }} .collection-card-grid__image-wrap {
    width: 100%;
    aspect-ratio: var(--cgrid-aspect-ratio, 4 / 3);
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }}px;
    background-color: #f5f5f5;
  }

  #section-{{ section.id }} .collection-card-grid__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #section-{{ section.id }} .collection-card-grid__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #section-{{ section.id }} .collection-card-grid__content {
    padding-top: {{ section.settings.content_gap }}px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #section-{{ section.id }} .collection-card-grid__heading {
    margin: 0;
  }

  #section-{{ section.id }} .collection-card-grid__description {
    margin: 0;
    opacity: 0.75;
  }

  #section-{{ section.id }} .collection-card-grid__button-wrap {
    margin-top: {{ section.settings.button_top_gap }}px;
  }

  #section-{{ section.id }} .collection-card-grid__button {
    display: inline-block;
    padding: {{ section.settings.button_padding_v }}px {{ section.settings.button_padding_h }}px;
    text-decoration: none;
    font-size: inherit;
    line-height: 1;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #section-{{ section.id }} .collection-card-grid__button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 768px) {
    #section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px !important;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px !important;
    }

    #section-{{ section.id }} .collection-card-grid__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_card_gap }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Collection Card Grid",
  "tag": "section",
  "class": "collection-card-grid-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards (desktop)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_card_gap",
      "label": "Gap between cards (mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "16 / 9", "label": "16:9 — Landscape wide" },
        { "value": "4 / 3", "label": "4:3 — Landscape" },
        { "value": "3 / 2", "label": "3:2 — Landscape" },
        { "value": "1 / 1", "label": "1:1 — Square" },
        { "value": "2 / 3", "label": "2:3 — Portrait" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between image and text",
      "min": 8,
      "max": 60,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Button Style"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background colour",
      "default": "#8c7b72"
    },
    {
      "type": "color",
      "id": "button_text_colour",
      "label": "Button text colour",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_padding_v",
      "label": "Button padding — top & bottom",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_padding_h",
      "label": "Button padding — left & right",
      "min": 12,
      "max": 80,
      "step": 4,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_top_gap",
      "label": "Space above button",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Background & Spacing"
    },
    {
      "type": "color",
      "id": "background_colour",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Collection name"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "Heading style",
          "info": "Inherits from your theme typography settings",
          "options": [
            { "value": "paragraph", "label": "Paragraph" },
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h3"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A short description of this collection."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Card Grid",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "For Mixed Feeding",
            "description": "For the in-between moments, the unpredictable routines, the both works best for us kind of days.",
            "button_label": "Shop Now"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "For Formula Feeding",
            "description": "Precision where it matters most. Built for accurate prep, controlled warming, and reliable results.",
            "button_label": "Shop Now"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "For Starting Solids",
            "description": "A smooth transition, thoughtfully supported. Designed to introduce solids with ease.",
            "button_label": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}