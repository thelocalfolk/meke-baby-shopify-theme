{% comment %}
  Section: Feature Cards Masonry
  A masonry-style image card grid on desktop, horizontal scroll carousel on mobile.
  Cards share the same design as Feature Cards Carousel — frosted glass pill label
  (top-left), gradient overlay, heading and body text at the bottom.
  Each card has its own height setting so the masonry stagger can be tuned card-by-card.
  Typography follows the same preset + custom pattern as Feature Cards Carousel.
  Built for the Mekè Baby Horizon theme.
{% endcomment %}

{%- liquid
  assign ss = section.settings
  assign blocks = section.blocks

  # Build section heading style string
  assign heading_style = ''
  if ss.heading_color != blank and ss.heading_color != ''
    assign heading_style = heading_style | append: '--color: ' | append: ss.heading_color | append: ';'
  endif
  if ss.heading_type_preset == 'custom'
    assign h_font_weight = ss.heading_font | replace: 'family', 'weight'
    assign heading_style = heading_style | append: '--font-family: ' | append: ss.heading_font | append: ';'
    assign heading_style = heading_style | append: '--font-weight: ' | append: h_font_weight | append: ';'
    assign heading_style = heading_style | append: '--font-size: ' | append: ss.heading_font_size | append: ';'
    assign heading_style = heading_style | append: '--text-transform: ' | append: ss.heading_case | append: ';'
    assign heading_style = heading_style | append: '--line-height: var(--line-height--heading-' | append: ss.heading_line_height | append: ');'
    assign heading_style = heading_style | append: '--letter-spacing: var(--letter-spacing--heading-' | append: ss.heading_letter_spacing | append: ');'
  endif

  if ss.heading_type_preset == 'custom'
    assign heading_class = 'fcm__heading custom-typography custom-font-size'
  else
    assign heading_class = 'fcm__heading ' | append: ss.heading_type_preset
  endif
-%}

<div class="section-background color-{{ ss.color_scheme }}"></div>

<div
  class="
    section
    section--{{ ss.section_width }}
    color-{{ ss.color_scheme }}
    section-feature-masonry
  "
  style="
    padding-top: {{ ss.padding_top }}px;
    padding-bottom: {{ ss.padding_bottom }}px;
    --fcm-mobile-padding-top: {{ ss.mobile_padding_top }}px;
    --fcm-mobile-padding-bottom: {{ ss.mobile_padding_bottom }}px;
    --fcm-columns: {{ ss.columns }};
    --fcm-gap: {{ ss.card_gap }}px;
    --fcm-radius: {{ ss.card_border_radius }}px;
    --fcm-label-size: {{ ss.label_size }}px;
    --fcm-mobile-card-width: {{ ss.mobile_card_width }}px;
    --fcm-mobile-card-height: {{ ss.mobile_card_height }}px;
  "
>
  {%- if ss.heading != blank -%}
    <h2 class="{{ heading_class }}" style="{{ heading_style }}">{{ ss.heading | escape }}</h2>
  {%- endif -%}

  {%- if blocks.size > 0 -%}

    <div class="fcm__grid-clip">
    <div class="fcm__grid" role="list" aria-label="Feature cards">
      {%- for block in blocks -%}
        {%- if block.type == 'card' -%}
          {%- liquid
            assign bs = block.settings

            # Card heading style
            assign card_heading_style = ''
            if bs.card_heading_color != blank and bs.card_heading_color != ''
              assign card_heading_style = card_heading_style | append: '--color: ' | append: bs.card_heading_color | append: ';'
            endif
            if bs.card_heading_preset == 'custom'
              assign ch_font_weight = bs.card_heading_font | replace: 'family', 'weight'
              assign card_heading_style = card_heading_style | append: '--font-family: ' | append: bs.card_heading_font | append: ';'
              assign card_heading_style = card_heading_style | append: '--font-weight: ' | append: ch_font_weight | append: ';'
              assign card_heading_style = card_heading_style | append: '--font-size: ' | append: bs.card_heading_font_size | append: ';'
              assign card_heading_style = card_heading_style | append: '--text-transform: ' | append: bs.card_heading_case | append: ';'
              assign card_heading_style = card_heading_style | append: '--line-height: var(--line-height--heading-' | append: bs.card_heading_line_height | append: ');'
              assign card_heading_style = card_heading_style | append: '--letter-spacing: var(--letter-spacing--heading-' | append: bs.card_heading_letter_spacing | append: ');'
            endif
            if bs.card_heading_preset == 'custom'
              assign card_heading_class = 'fcm__card-heading custom-typography custom-font-size'
            else
              assign card_heading_class = 'fcm__card-heading ' | append: bs.card_heading_preset
            endif

            # Card body style
            assign card_body_style = ''
            if bs.card_body_color != blank and bs.card_body_color != ''
              assign card_body_style = card_body_style | append: '--color: ' | append: bs.card_body_color | append: ';'
            endif
            if bs.card_body_preset == 'custom'
              assign cb_font_weight = bs.card_body_font | replace: 'family', 'weight'
              assign card_body_style = card_body_style | append: '--font-family: ' | append: bs.card_body_font | append: ';'
              assign card_body_style = card_body_style | append: '--font-weight: ' | append: cb_font_weight | append: ';'
              assign card_body_style = card_body_style | append: '--font-size: ' | append: bs.card_body_font_size | append: ';'
              assign card_body_style = card_body_style | append: '--text-transform: ' | append: bs.card_body_case | append: ';'
              assign card_body_style = card_body_style | append: '--line-height: var(--line-height--body-' | append: bs.card_body_line_height | append: ');'
              assign card_body_style = card_body_style | append: '--letter-spacing: var(--letter-spacing--body-' | append: bs.card_body_letter_spacing | append: ');'
            endif
            if bs.card_body_preset == 'custom'
              assign card_body_class = 'fcm__card-body custom-typography custom-font-size'
            else
              assign card_body_class = 'fcm__card-body ' | append: bs.card_body_preset
            endif
          -%}

          {%- liquid
            assign row_span = bs.card_height_desktop | divided_by: 10 | ceil
            assign gap_rows = ss.card_gap | divided_by: 10 | ceil
            assign total_span = row_span | plus: gap_rows
          -%}
          <div
            class="fcm__card"
            role="listitem"
            style="
              --fcm-card-height: {{ bs.card_height_desktop }}px;
              --fcm-content-gap: {{ bs.content_gap }}px;
              grid-row: span {{ total_span }};
            "
            {{ block.shopify_attributes }}
          >
            {%- if bs.link != blank -%}
              <a class="fcm__card-link" href="{{ bs.link }}" aria-label="{{ bs.heading | escape }}">
            {%- endif -%}

            <div class="fcm__card-image">
              {%- if bs.image != blank -%}
                {%- assign card_alt = bs.heading | escape -%}
                {{
                  bs.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,900',
                    sizes: '(max-width: 749px) 85vw, 25vw',
                    alt: card_alt,
                    class: 'fcm__img'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'fcm__img fcm__img--placeholder' }}
              {%- endif -%}
            </div>

            <div class="fcm__overlay" aria-hidden="true"></div>

            <div class="fcm__card-content" style="padding: {{ bs.card_padding }}px;">
              {%- if bs.label != blank -%}
                <span class="fcm__label">{{ bs.label | escape }}</span>
              {%- endif -%}

              <div class="fcm__card-text">
                {%- if bs.heading != blank -%}
                  <p class="{{ card_heading_class }}" style="{{ card_heading_style }}">{{ bs.heading | escape }}</p>
                {%- endif -%}
                {%- if bs.body != blank -%}
                  <p class="{{ card_body_class }}" style="{{ card_body_style }}">{{ bs.body | escape }}</p>
                {%- endif -%}
              </div>
            </div>

            {%- if bs.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    </div>

  {%- endif -%}
</div>

{% stylesheet %}

  /* ─── Section wrapper ─── */
  .section-feature-masonry {
    row-gap: var(--gap-md, 24px);
  }

  .fcm__heading {
    margin: 0;
    color: var(--color, inherit);
  }

  /* ─── Grid clip wrapper ─── */
  /* On desktop: transparent passthrough, grid handles layout.
     On mobile: becomes grid-column 2/-1 to bleed right past the section margin. */
  .fcm__grid-clip {
    width: 100%;
  }

  /* ─── Desktop masonry grid ─── */
  /* CSS Grid with a dense 10px row unit. Each card spans a calculated number of
     rows based on its individual height setting, giving left-to-right ordering
     that matches the theme editor block order. */
  .fcm__grid {
    display: grid;
    grid-template-columns: repeat(var(--fcm-columns, 4), 1fr);
    grid-auto-rows: 10px;
    column-gap: var(--fcm-gap, 12px);
    row-gap: 0;
    width: 100%;
  }

  /* ─── Card ─── */
  .fcm__card {
    position: relative;
    width: 100%;
    height: var(--fcm-card-height, 420px);
    border-radius: var(--fcm-radius, 16px);
    overflow: hidden;
    /* grid-row span is set inline in Liquid based on card_height_desktop */
  }

  /* Linked card — reset anchor styles */
  .fcm__card-link {
    display: contents;
    text-decoration: none;
    color: inherit;
  }

  /* Background image fills the card */
  .fcm__card-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .fcm__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fcm__img--placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.6;
  }

  /* Gradient overlay — stronger at bottom for text legibility */
  .fcm__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      transparent 25%,
      rgba(0, 0, 0, 0.10) 50%,
      rgba(0, 0, 0, 0.65) 100%
    );
  }

  /* Content layer — label top-left, text block bottom-left */
  .fcm__card-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Frosted glass pill label */
  .fcm__label {
    display: inline-block;
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: #ffffff;
    font-size: var(--fcm-label-size, 10px);
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 15px 20px;
    border-radius: 100px;
    line-height: 1;
  }

  /* Bottom text block */
  .fcm__card-text {
    display: flex;
    flex-direction: column;
    gap: var(--fcm-content-gap, 10px);
  }

  .fcm__card-heading {
    margin: 0;
    color: var(--color, #ffffff);
    line-height: 1.15;
  }

  .fcm__card-body {
    margin: 0;
    color: var(--color, rgba(255, 255, 255, 0.80));
  }

  /* For full-width sections, clip spans all columns */
  .section--full-width .fcm__grid-clip {
    grid-column: 1 / -1;
  }

  /* Hover lift — subtle, respects reduced-motion */
  @media (hover: hover) {
    .fcm__card {
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .fcm__card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    }
  }

  /* ─── Mobile — horizontal carousel ─── */
  /* Below 750px, collapse the column layout into a swipeable horizontal track.
     Matches the behaviour and feel of the Feature Cards Carousel section. */
  @media screen and (max-width: 749px) {

    /* Clip wrapper — grid-column 2/-1 starts at content column and bleeds right.
     This matches the confirmed working pattern from the Feature Cards Carousel. */
    .fcm__grid-clip {
      grid-column: 2 / -1;
      overflow: hidden;
    }

    .fcm__grid {
      /* Override desktop grid — become a horizontal flex scroll container */
      display: flex;
      flex-direction: row;
      gap: var(--fcm-gap, 12px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .fcm__grid::-webkit-scrollbar {
      display: none;
    }

    .fcm__card {
      /* Fixed card size — never shrinks */
      flex: 0 0 auto;
      width: min(var(--fcm-mobile-card-width, 300px), 80vw);
      height: var(--fcm-mobile-card-height, 460px);
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    .section-feature-masonry {
      padding-top: var(--fcm-mobile-padding-top);
      padding-bottom: var(--fcm-mobile-padding-bottom);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fcm__card {
      transition: none;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Feature Cards Masonry",
  "tag": "section",
  "class": "section-feature-masonry-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A better way to formula feed"
    },
    {
      "type": "select",
      "id": "heading_type_preset",
      "label": "Heading style",
      "info": "Inherits font, size and weight from your theme typography settings",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "var(--font-heading--family)",
      "visible_if": "{{ section.settings.heading_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading size",
      "options": [
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" },
        { "value": "1.25rem", "label": "20px" },
        { "value": "1.5rem", "label": "24px" },
        { "value": "1.75rem", "label": "28px" },
        { "value": "2rem", "label": "32px" },
        { "value": "2.5rem", "label": "40px" },
        { "value": "3rem", "label": "48px" }
      ],
      "default": "2rem",
      "visible_if": "{{ section.settings.heading_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_line_height",
      "label": "Heading line height",
      "options": [
        { "value": "tight", "label": "Tight" },
        { "value": "normal", "label": "Normal" },
        { "value": "loose", "label": "Loose" }
      ],
      "default": "tight",
      "visible_if": "{{ section.settings.heading_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "options": [
        { "value": "tight", "label": "Tight" },
        { "value": "normal", "label": "Normal" },
        { "value": "loose", "label": "Loose" }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.heading_type_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Heading case",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
