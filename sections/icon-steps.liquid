{% comment %}
  Section: Icon Steps
  Multi-column icon + title + description section. Built for Meke Baby on the Horizon theme.
  Colour scheme pattern copied exactly from brand-story-split.liquid.
{% endcomment %}

{%- liquid
  assign col_align = section.settings.content_alignment
  assign flex_align = 'flex-start'
  if col_align == 'center'
    assign flex_align = 'center'
  elsif col_align == 'right'
    assign flex_align = 'flex-end'
  endif
-%}

<div
  class="icon-steps-section color-{{ section.settings.color_scheme }}"
  id="section-{{ section.id }}"
  style="
    --is-pt: {{ section.settings.padding_top }}px;
    --is-pb: {{ section.settings.padding_bottom }}px;
    --is-mobile-pt: {{ section.settings.mobile_padding_top }}px;
    --is-mobile-pb: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="icon-steps-section__inner">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="icon-steps-section__header" style="text-align: {{ col_align }}; margin-bottom: {{ section.settings.header_bottom_gap }}px;">

        {%- if section.settings.heading != blank -%}
          <p class="icon-steps-section__heading" style="margin-bottom: {{ section.settings.heading_gap }}px;">
            {{ section.settings.heading | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="icon-steps-section__subheading">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}

      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="icon-steps-section__grid"
        style="
          text-align: {{ col_align }};
          grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
          gap: {{ section.settings.column_gap }}px;
        "
      >
        {%- for block in section.blocks -%}
          <div
            class="icon-steps-section__item"
            style="align-items: {{ flex_align }}; gap: {{ section.settings.item_gap }}px;"
            {{ block.shopify_attributes }}
          >

            {%- if block.settings.icon != blank -%}
              {%- assign icon_alt = block.settings.title | escape -%}
              {%- assign icon_sizes = section.settings.icon_size | append: 'px' -%}
              <div
                class="icon-steps-section__icon"
                style="width: {{ section.settings.icon_size }}px; height: {{ section.settings.icon_size }}px;"
              >
                {{
                  block.settings.icon
                  | image_url: width: 200
                  | image_tag:
                    loading: 'lazy',
                    alt: icon_alt,
                    widths: '80,100,120,160,200',
                    sizes: icon_sizes,
                    style: 'width: 100%; height: 100%; object-fit: contain;'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <p class="icon-steps-section__title">
                {{ block.settings.title | escape }}
              </p>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="icon-steps-section__description">
                {{ block.settings.description }}
              </div>
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  #section-{{ section.id }} {
    padding-top: var(--is-pt);
    padding-bottom: var(--is-pb);
  }

  @media (max-width: 749px) {
    #section-{{ section.id }} {
      padding-top: var(--is-mobile-pt);
      padding-bottom: var(--is-mobile-pb);
    }
    #section-{{ section.id }} .icon-steps-section__grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr) !important;
    }
  }
</style>

{% stylesheet %}
  .icon-steps-section {
    background-color: rgb(var(--color-background));
  }

  .icon-steps-section__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding-left: var(--page-margin, 24px);
    padding-right: var(--page-margin, 24px);
  }

  .icon-steps-section__heading {
    font-family: var(--font-h2--family);
    font-size: var(--font-h2--size);
    font-weight: var(--font-h2--weight);
    line-height: var(--font-h2--line-height);
    letter-spacing: var(--font-h2--letter-spacing);
    text-transform: var(--font-h2--case);
    color: rgb(var(--color-foreground-heading));
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .icon-steps-section__subheading {
    color: rgb(var(--color-foreground));
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 0;
  }

  .icon-steps-section__title {
    font-family: var(--font-h5--family);
    font-size: var(--font-h5--size);
    font-weight: var(--font-h5--weight);
    line-height: var(--font-h5--line-height);
    letter-spacing: var(--font-h5--letter-spacing);
    text-transform: var(--font-h5--case);
    color: rgb(var(--color-foreground-heading));
    margin: 0;
  }

  .icon-steps-section__grid {
    display: grid;
  }

  .icon-steps-section__item {
    display: flex;
    flex-direction: column;
  }

  .icon-steps-section__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-steps-section__description {
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  .icon-steps-section__description p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Icon Steps",
  "tag": "section",
  "class": "icon-steps-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "That\u2019s why we created the 3-Step feeding system"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Meke Baby simplifies feeding into a clear, repeatable system \u2014 so you know exactly what to do, every time."
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Gap between heading and subheading",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_bottom_gap",
      "label": "Gap below header (to icons)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between icon and text",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colours & Spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>A short description of this step.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Safe Storage",
            "description": "<p>Keep milk protected, properly stored, and ready when you need it. Microplastic-free, leak-proof pouches designed for fridge, freezer, and on-the-go use.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Warm with Precision",
            "description": "<p>Heat food safely, wherever feeding happens. Designed to warm milk or food in under 3 minutes with consistent, controlled temperature \u2014 at home or on the go.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Feed without guesswork",
            "description": "<p>A considered approach to feeding, designed to support safe, consistent results at every stage.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}