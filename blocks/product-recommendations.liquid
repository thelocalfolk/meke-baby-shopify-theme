{%- doc -%}
  Product recommendations — Meke Baby custom layout.

  Renders each recommended product as a horizontal "cross-sell" card
  (image left, title / price / purple Add to cart on the right) to match
  the bundle card example, instead of the theme's default vertical product card.

  The Add to cart button uses the theme's native product-form-component, so it
  adds straight to cart and the cart drawer opens — same as a normal Add to cart.

  Recommendations still load via the Section Rendering API (product-recommendations.js).
{%- enddoc -%}

<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
></script>

{% liquid
  assign block_settings = block.settings
%}

<product-recommendations
  id="product-recommendations-{{ block.id }}"
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?limit={{ block_settings.max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ closest.product.id }}"
  data-intent="{{ block_settings.recommendation_type }}"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-hydration-key="product-recommendations-{{ block.id }}"
  {% if request.visual_preview_mode %}
    data-shopify-editor-preview
  {% endif %}
  data-testid="product-recommendations-block"
  {{ block.shopify_attributes }}
>
  <div
    class="
      {% if block_settings.inherit_color_scheme == false %}color-{{ block_settings.color_scheme }}{% endif %}
      rec-block
      spacing-style
    "
    style="
      {% render 'spacing-style', settings: block_settings %}
      --rec-card-bg: {{ block_settings.card_background }};
      --rec-card-radius: {{ block_settings.card_radius }}px;
      --rec-card-gap: {{ block_settings.card_gap }}px;
      --rec-img-size: {{ block_settings.image_size }}px;
      --rec-img-radius: {{ block_settings.image_radius }}px;
      --rec-button-bg: {{ block_settings.button_color }};
      --rec-button-text: {{ block_settings.button_text_color }};
    "
  >
    <div class="rec-block__heading">
      {% content_for 'blocks' %}
    </div>

    {%- if recommendations.performed or closest.product == blank -%}
      {% liquid
        assign products = recommendations.products

        if closest.product == blank
          # Onboarding mode: show placeholder cards in the editor
          for i in (1..block_settings.max_products)
            assign products = products | append: ', '
            assign products = products | split: ','
          endfor
        elsif recommendations.performed and recommendations.products_count == 0
          if block_settings.recommendation_type == 'related'
            assign products = collections.all.products | reject: 'id', closest.product.id
          else
            assign products = null
          endif
        else
          assign products = recommendations.products
        endif
      %}

      <div class="rec-list" data-has-recommendations="{% if products != blank and products.size > 0 %}true{% else %}false{% endif %}">
        {% for product in products limit: block_settings.max_products %}
          {%- if product != blank and product.id != blank -%}
            {%- assign rec_variant = product.selected_or_first_available_variant -%}
            <div class="rec-card">
              <a
                href="{{ product.url }}"
                class="rec-card__image-wrap"
                aria-label="{{ product.title | escape }}"
                tabindex="-1"
              >
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 400
                    | image_tag:
                      loading: 'lazy',
                      class: 'rec-card__image',
                      widths: '120,180,240,360',
                      sizes: '120px',
                      alt: product.title | escape
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'rec-card__image rec-card__image--placeholder' }}
                {%- endif -%}
              </a>

              <div class="rec-card__details">
                <a href="{{ product.url }}" class="rec-card__title">{{ product.title | escape }}</a>

                {%- if block_settings.show_description -%}
                  {%- comment -%} Prefer the custom.sub_heading_description metafield, fall back to the product description {%- endcomment -%}
                  {%- assign rec_subheading = product.metafields.custom.sub_heading_description.value -%}
                  {%- if rec_subheading != blank -%}
                    <p class="rec-card__description">{{ rec_subheading | strip_html }}</p>
                  {%- elsif product.description != blank -%}
                    <p class="rec-card__description">{{ product.description | strip_html | truncate: 110 }}</p>
                  {%- endif -%}
                {%- endif -%}

                <p class="rec-card__price">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="rec-card__price-sale">{{ product.price | money }}</span>
                    <s class="rec-card__price-compare">{{ product.compare_at_price | money }}</s>
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </p>

                {%- if block_settings.show_add_to_cart -%}
                  {%- if rec_variant != blank and rec_variant.available -%}
                    {%- capture rec_form_id -%}ProductRecsForm-{{ block.id }}-{{ forloop.index }}{%- endcapture -%}
                    <product-form-component
                      class="rec-card__form"
                      data-section-id="{{ section.id }}"
                      data-product-id="{{ product.id }}"
                      data-product-url="{{ product.url }}"
                      on:submit="/handleSubmit"
                    >
                      <div
                        class="visually-hidden"
                        aria-live="assertive"
                        role="status"
                        aria-atomic="true"
                        ref="liveRegion"
                      ></div>
                      {%- form 'product', product, id: rec_form_id, data-type: 'add-to-cart-form' -%}
                        <input
                          type="hidden"
                          name="id"
                          ref="variantId"
                          value="{{ rec_variant.id }}"
                        >
                        <button type="submit" name="add" class="rec-card__button">
                          {{ block_settings.add_to_cart_label | default: 'Add to cart' | escape }}
                        </button>
                      {%- endform -%}
                    </product-form-component>
                  {%- else -%}
                    <a href="{{ product.url }}" class="rec-card__button rec-card__button--link">
                      {{ 'products.product.sold_out' | t | default: 'View product' }}
                    </a>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>

          {%- elsif closest.product == blank -%}
            {%- comment -%} Editor onboarding placeholder card {%- endcomment -%}
            <div class="rec-card rec-card--placeholder">
              <div class="rec-card__image-wrap">
                {{ 'product-1' | placeholder_svg_tag: 'rec-card__image rec-card__image--placeholder' }}
              </div>
              <div class="rec-card__details">
                <span class="rec-card__title">{{ 'onboarding.product_title' | t | default: 'Example product' }}</span>
                <p class="rec-card__price">{{ 1999 | money }}</p>
                {%- if block_settings.show_add_to_cart -%}
                  <span class="rec-card__button">
                    {{ block_settings.add_to_cart_label | default: 'Add to cart' | escape }}
                  </span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {% endfor %}
      </div>
    {%- else -%}
      <div class="rec-list">
        {% for i in (1..block_settings.max_products) %}
          <div
            class="rec-card rec-card--skeleton"
            aria-label="{{ 'accessibility.loading_product_recommendations' | t }}"
          >
            <div class="rec-card__image-wrap"></div>
            <div class="rec-card__details">
              <span class="rec-card__skeleton-line rec-card__skeleton-line--title"></span>
              <span class="rec-card__skeleton-line rec-card__skeleton-line--price"></span>
              <span class="rec-card__skeleton-line rec-card__skeleton-line--button"></span>
            </div>
          </div>
        {% endfor %}
      </div>
    {%- endif -%}
  </div>
</product-recommendations>

{% stylesheet %}
  .rec-block {
    width: 100%;
    container-type: inline-size;
  }

  .rec-block__heading {
    margin-bottom: 12px;
  }

  .rec-list {
    display: flex;
    flex-direction: column;
    gap: var(--rec-card-gap, 12px);
  }

  /* Horizontal cross-sell card */
  .rec-card {
    display: flex;
    align-items: stretch;
    gap: 20px;
    padding: 16px;
    background-color: var(--rec-card-bg, #ffffff);
    border-radius: var(--rec-card-radius, 16px);
    /* Match the rest of the site's body typography */
    font-family: var(--font-body--family, inherit);
    font-style: var(--font-body--style, normal);
    font-weight: var(--font-body--weight, 400);
  }

  .rec-card__image-wrap {
    flex: 0 0 var(--rec-img-size, 110px);
    width: var(--rec-img-size, 110px);
    height: var(--rec-img-size, 110px);
    align-self: center;
    border-radius: var(--rec-img-radius, 12px);
    overflow: hidden;
    background-color: #f5f0eb;
    display: block;
  }

  .rec-card__image,
  .rec-card__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rec-card__details {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .rec-card__title {
    font-size: 1rem;
    font-weight: var(--font-body--weight, 400);
    line-height: 1.3;
    color: inherit;
    text-decoration: none;
  }

  .rec-card__title:hover {
    text-decoration: underline;
  }

  .rec-card__description {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.5;
    opacity: 0.7;
    /* Cut off at 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rec-card__price {
    margin: 0;
    font-size: 0.95rem;
    font-weight: var(--font-body--weight, 400);
  }

  .rec-card__price-compare {
    margin-left: 6px;
    font-weight: 400;
    opacity: 0.5;
  }

  /* Purple Add to cart button (self-contained, not the theme's full-width button) */
  .rec-card__button {
    display: inline-block;
    align-self: flex-start;
    margin-top: 4px;
    padding: 11px 26px;
    border: none;
    border-radius: 999px;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    font-family: var(--font-body--family, inherit);
    font-weight: var(--font-body--weight, 400);
    background-color: var(--rec-button-bg, #C6B7E2);
    color: var(--rec-button-text, #2E2A39);
    transition: background-color 0.2s ease;
  }

  .rec-card__button:hover {
    background-color: color-mix(in srgb, var(--rec-button-bg, #C6B7E2) 88%, #000);
  }

  /* Push the button (or its form) to the bottom so it lines up with the image */
  .rec-card__form,
  .rec-card__details > .rec-card__button {
    margin-top: auto;
  }

  .rec-card__form {
    margin-bottom: 0;
    margin-inline: 0;
    display: block;
  }

  /* Skeleton */
  .rec-card--skeleton .rec-card__image-wrap {
    animation: rec-pulse 1.2s ease-in-out infinite;
  }

  .rec-card__skeleton-line {
    display: block;
    height: 12px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.08);
    animation: rec-pulse 1.2s ease-in-out infinite;
  }

  .rec-card__skeleton-line--title { width: 70%; }
  .rec-card__skeleton-line--price { width: 30%; }
  .rec-card__skeleton-line--button { width: 120px; height: 36px; border-radius: 999px; margin-top: 6px; }

  @keyframes rec-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* Mobile */
  @media (max-width: 749px) {
    .rec-card {
      gap: 14px;
      padding: 12px;
    }

    .rec-card__image-wrap {
      flex-basis: 88px;
      width: 88px;
    }

    .rec-card__button {
      width: 100%;
      align-self: stretch;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_recommendations",
  "class": "product-recommendations-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_recommendations"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "related",
          "label": "t:options.related"
        },
        {
          "value": "complementary",
          "label": "t:options.complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Add to cart button"
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart button",
      "default": true
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Button text",
      "default": "Add to cart"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button colour",
      "default": "#C6B7E2"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text colour",
      "default": "#2E2A39"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "default": false
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background colour",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 64,
      "max": 200,
      "step": 2,
      "default": 110,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:settings.color_scheme"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_recommendations",
      "category": "t:categories.product",
      "settings": {
        "recommendation_type": "related"
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "t:html_defaults.may_also_like"
          }
        }
      },
      "block_order": ["heading"]
    }
  ]
}
{% endschema %}