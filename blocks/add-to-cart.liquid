{%- doc -%}
  This block is used to display the add to cart button.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param {string} add_to_cart_text - The text of the add to cart button
{%- enddoc -%}

{% liquid
  assign class = 'add-to-cart-button ' | append: block.settings.style_class
  assign id = 'BuyButtons-ProductSubmitButton-' | append: block.id

  # --- Pre-order delivery message (added for Meke Baby) -----------------------
  # Shows a custom line ABOVE the button when the selected variant is a
  # pre-order (sold out + "Continue selling when out of stock"). The text is
  # set per product in admin via the metafield custom.preorder_message.
  #
  # Lookup order: variant-level metafield first (optional override), then the
  # product-level metafield. You only need to create the PRODUCT definition;
  # the variant lookup is harmless if no variant definition exists.
  assign po_product = closest.product
  assign po_variant = po_product.selected_or_first_available_variant

  assign is_preorder = false
  if po_variant.inventory_management != blank and po_variant.inventory_policy == 'continue' and po_variant.inventory_quantity <= 0
    assign is_preorder = true
  endif

  assign preorder_message = po_variant.metafields.custom.preorder_message.value
  if preorder_message == blank
    assign preorder_message = po_product.metafields.custom.preorder_message.value
  endif
  # ---------------------------------------------------------------------------
%}

<span
  {{ block.shopify_attributes }}
  style="--add-to-cart-font-case: {{ settings.button_text_case }};"
>
  {%- comment -%} Pre-order delivery line, only on pre-order variants with a message set {%- endcomment -%}
  {%- comment -%} request.page_type == 'product' keeps this on the PDP only, not quick-adds / homepage / featured-product blocks {%- endcomment -%}
  {%- if is_preorder and preorder_message != blank and request.page_type == 'product' -%}
    <p class="preorder-message">
      {%- comment -%} Swap this SVG for a truck/calendar icon if you prefer; it inherits the text colour {%- endcomment -%}
      <svg class="preorder-message__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3 2"></path>
      </svg>
      <span>{{ preorder_message }}</span>
    </p>
  {%- endif -%}

  {% render 'add-to-cart-button',
    id: id,
    class: class,
    can_add_to_cart: can_add_to_cart,
    product: closest.product,
    add_to_cart_text: add_to_cart_text,
    data_testid: 'standalone-add-to-cart'
  %}
</span>

{%- comment -%} Minimal styling for the pre-order line; tweak to taste {%- endcomment -%}
{%- stylesheet -%}
  .preorder-message {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: rgb(var(--color-foreground) / 0.7);
  }

  .preorder-message__icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin-top: 0.05rem;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "t:names.add_to_cart",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        }
      ],
      "default": "button-secondary"
    }
  ]
}
{% endschema %}