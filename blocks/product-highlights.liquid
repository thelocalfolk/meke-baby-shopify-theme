{% comment %}
  Block: Product Highlights
  Theme: Horizon — Meke Baby
  Renders up to 4 icon + text rows.
  Icons and text are entered directly in the theme editor right-hand panel.
{% endcomment %}

{%- liquid
  assign icon_1 = block.settings.highlight_icon_1
  assign text_1 = block.settings.highlight_text_1
  assign icon_2 = block.settings.highlight_icon_2
  assign text_2 = block.settings.highlight_text_2
  assign icon_3 = block.settings.highlight_icon_3
  assign text_3 = block.settings.highlight_text_3
  assign icon_4 = block.settings.highlight_icon_4
  assign text_4 = block.settings.highlight_text_4
-%}

{%- if text_1 != blank or text_2 != blank or text_3 != blank or text_4 != blank -%}
  <div
    id="block-{{ block.id }}"
    class="product-highlights"
    {{ block.shopify_attributes }}
  >
    <ul class="product-highlights__list">

      {%- if text_1 != blank -%}
        <li class="product-highlights__item">
          {%- if icon_1 != blank -%}
            <img
              src="{{ icon_1 | image_url: width: 56 }}"
              alt=""
              class="product-highlights__icon"
              width="{{ block.settings.icon_size }}"
              height="{{ block.settings.icon_size }}"
              aria-hidden="true"
              loading="lazy"
            >
          {%- endif -%}
          <span class="product-highlights__text">{{ text_1 }}</span>
        </li>
      {%- endif -%}

      {%- if text_2 != blank -%}
        <li class="product-highlights__item">
          {%- if icon_2 != blank -%}
            <img
              src="{{ icon_2 | image_url: width: 56 }}"
              alt=""
              class="product-highlights__icon"
              width="{{ block.settings.icon_size }}"
              height="{{ block.settings.icon_size }}"
              aria-hidden="true"
              loading="lazy"
            >
          {%- endif -%}
          <span class="product-highlights__text">{{ text_2 }}</span>
        </li>
      {%- endif -%}

      {%- if text_3 != blank -%}
        <li class="product-highlights__item">
          {%- if icon_3 != blank -%}
            <img
              src="{{ icon_3 | image_url: width: 56 }}"
              alt=""
              class="product-highlights__icon"
              width="{{ block.settings.icon_size }}"
              height="{{ block.settings.icon_size }}"
              aria-hidden="true"
              loading="lazy"
            >
          {%- endif -%}
          <span class="product-highlights__text">{{ text_3 }}</span>
        </li>
      {%- endif -%}

      {%- if text_4 != blank -%}
        <li class="product-highlights__item">
          {%- if icon_4 != blank -%}
            <img
              src="{{ icon_4 | image_url: width: 56 }}"
              alt=""
              class="product-highlights__icon"
              width="{{ block.settings.icon_size }}"
              height="{{ block.settings.icon_size }}"
              aria-hidden="true"
              loading="lazy"
            >
          {%- endif -%}
          <span class="product-highlights__text">{{ text_4 }}</span>
        </li>
      {%- endif -%}

    </ul>
  </div>
{%- endif -%}

<style>
  #block-{{ block.id }} .product-highlights__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.row_gap }}px;
  }

  #block-{{ block.id }} .product-highlights__item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: {{ block.settings.text_size }};
    line-height: var(--font-paragraph--line-height, 1.5);
    color: var(--color-foreground);
  }

  #block-{{ block.id }} .product-highlights__icon {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    object-fit: contain;
  }

  #block-{{ block.id }} .product-highlights__text {
    flex: 1;
  }
</style>

{% schema %}
{
  "name": "Product Highlights",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Row 1"
    },
    {
      "type": "text",
      "id": "highlight_text_1",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "highlight_icon_1",
      "label": "Icon"
    },
    {
      "type": "header",
      "content": "Row 2"
    },
    {
      "type": "text",
      "id": "highlight_text_2",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "highlight_icon_2",
      "label": "Icon"
    },
    {
      "type": "header",
      "content": "Row 3"
    },
    {
      "type": "text",
      "id": "highlight_text_3",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "highlight_icon_3",
      "label": "Icon"
    },
    {
      "type": "header",
      "content": "Row 4"
    },
    {
      "type": "text",
      "id": "highlight_text_4",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "highlight_icon_4",
      "label": "Icon"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 56,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "0.80rem", "label": "Small" },
        { "value": "0.875rem", "label": "Medium" },
        { "value": "1rem", "label": "Large" }
      ],
      "default": "0.875rem"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Highlights"
    }
  ]
}
{% endschema %}