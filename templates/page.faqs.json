            "accordion_row_MQN8xk": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How do I clean my Meke Twist?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_xaGY4M": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Do not boil the formula cartridge box at high temperature when it is in the storage/OFF position. After high temp sterilisation, do not immediately rotate the formula cartridge. Once it has cooled down, it can be rotated. Please do not use a UV steriliser or exceed 110ºC for silicone.</p>",
