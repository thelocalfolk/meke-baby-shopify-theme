            "accordion_row_gtVQCJ": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How long can I safely leave heated breastmilk in the Express?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_XNkQHY": {
                  "type": "text",
                  "settings": {
                    "text": "<p>According to safety guidelines, once breastmilk has been heated, it should be used within 2 hours and then discarded if not consumed.</p>",
