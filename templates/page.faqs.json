              ]
            },
            "accordion_row_YAUDJF": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How do I clean the warmer between uses while on the go?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_xEEMwK": {
                  "type": "text",
                  "settings": {
                    "text": "<p>If using sterile water for formula preparation, cleaning between uses is not necessary. If using for breastmilk or cows milk, it must be rinsed out straight away after use and clean it with 3 % hydrogen peroxide or the warm soapy water method. At the end of the day use the self-sanitise function while charging.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
