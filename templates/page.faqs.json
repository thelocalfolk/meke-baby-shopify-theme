                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_yfM9kM": {
                  "type": "text",
                  "settings": {
                    "text": "<p>The TWIST comes with an integrated formula dispenser capable of holding up to four scoops of formula until it's time to serve. Once the cartridge is turned 'on', the silicone will twist into an open position, dropping the formula into the water with ease. Simply twist, shake and feed!</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
