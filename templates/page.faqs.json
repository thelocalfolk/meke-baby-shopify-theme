            },
            "accordion_row_jLYmND": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Why does the temperature fluctuate?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_T7phU8": {
                  "type": "text",
                  "settings": {
                    "text": "<p>The temperature fluctuation is completely normal and is part of the warmer's process of heating the milk safely to ensure even heating and no hot spots. When the warmer reaches the set temperature, it will sound a beep to indicate it's ready.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
