                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_dQzGQa": {
                  "type": "text",
                  "settings": {
                    "text": "<p>No, the lid is likely locked. Ensure you have unlocked it by pressing the button in the middle.</p>",
                    "width": "100%",
                    "max_width": "none",
