              "blocks": {
                "text_Yeaany": {
                  "type": "text",
                  "settings": {
                    "text": "<p>The Express is designed to stay on for convenience. If you leave home, fill it with 500ml of water and keep it on so it's ready when needed. Heating multiple full cycles will drain the battery faster.</p>",
                    "width": "100%",
